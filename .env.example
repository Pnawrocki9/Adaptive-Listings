# =============================================================================
# Estalara Adaptive Listings — Environment Variables Reference
# =============================================================================
# Copy this file to .env.local for local overrides (never commit .env.local).
# In real environments all secrets are fetched from Doppler at runtime.
# Run `bash scripts/doppler-bootstrap.sh` to set up your local Doppler access.
# =============================================================================

# ── Turborepo Remote Cache ────────────────────────────────────────────────────
# Used by CI to share build caches across runners.
TURBO_TOKEN=                # Vercel Turborepo token (set in GitHub Actions secrets)
TURBO_TEAM=                 # Vercel team slug (set in GitHub Actions secrets)

# ── Cloudflare ────────────────────────────────────────────────────────────────
# Provisioned in TICKET-008.
CLOUDFLARE_API_TOKEN=       # Cloudflare API token with Workers + R2 + DNS permissions
CLOUDFLARE_ACCOUNT_ID=      # Cloudflare account ID (not a secret, but keep centralised here)
CLOUDFLARE_ZONE_ID=         # Zone ID for estalara.com (canonical domain)

# ── Supabase (Postgres + Auth) ────────────────────────────────────────────────
# One set per region (fra1/iad1/lhr1/dxb1). Provisioned in TICKET-009.
SUPABASE_URL=               # https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=          # Public anon key (safe for browser, but still in Doppler)
SUPABASE_SERVICE_ROLE_KEY=  # Secret service-role key — NEVER expose to browser
SUPABASE_JWT_SECRET=        # JWT signing secret (matches Supabase project setting)

# ── ClickHouse Cloud ──────────────────────────────────────────────────────────
# Provisioned in TICKET-009.
CLICKHOUSE_HOST=            # e.g. abc123.eu-central-1.aws.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=            # Service account username
CLICKHOUSE_PASSWORD=        # Service account password
CLICKHOUSE_DATABASE=estalara

# ── Redpanda Cloud ────────────────────────────────────────────────────────────
# Provisioned in TICKET-009.
REDPANDA_BROKERS=           # Comma-separated broker list, e.g. seed-abc.us-east-1.cloud.redpanda.com:9092
REDPANDA_SASL_USERNAME=     # SASL/SCRAM username
REDPANDA_SASL_PASSWORD=     # SASL/SCRAM password
REDPANDA_TLS=true

# ── Upstash Redis ─────────────────────────────────────────────────────────────
# Provisioned in TICKET-009.
#
# ENV-VAR PARITY REQUIREMENT (FOLLOW-368 / docs/runbooks/upstash-redis-env-parity.md):
# The Python writer (Modal) uses UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN.
# The TypeScript reader (Vercel) uses UPSTASH_REDIS_URL / UPSTASH_REDIS_TOKEN.
# BOTH PAIRS MUST POINT AT THE SAME UPSTASH DATABASE. If they differ, the chat-intent
# shadow bridge (write_shadow_intent → readShadowChatIntent) silently misses.
# Verify parity: run `tests/integration/redis-shadow-round-trip.smoke.test.ts` or
# compare URL values in Doppler. See backlog/ESCALATIONS.md ESC-028.
#
UPSTASH_REDIS_REST_URL=     # https://<db>.upstash.io  — Modal (Python writer) env var name
UPSTASH_REDIS_REST_TOKEN=   # REST API token            — Modal (Python writer) env var name
UPSTASH_REDIS_URL=          # https://<db>.upstash.io  — Vercel (TS reader) env var name; SAME URL as REST_URL
UPSTASH_REDIS_TOKEN=        # REST API token            — Vercel (TS reader) env var name; SAME token as REST_TOKEN

# ── Modal ─────────────────────────────────────────────────────────────────────
# Provisioned in TICKET-009.
MODAL_TOKEN_ID=             # Modal token ID
MODAL_TOKEN_SECRET=         # Modal token secret

# ── LLM / AI ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=          # Claude API key (Haiku 4.5 + Sonnet 4.6)
OPENAI_API_KEY=             # OpenAI API key (text-embedding-3-small)
LITELLM_MASTER_KEY=         # LiteLLM router master key

# ── Sentry ────────────────────────────────────────────────────────────────────
# Provisioned in TICKET-003.
SENTRY_DSN=                 # Sentry project DSN (all services share one org, separate projects)
SENTRY_AUTH_TOKEN=          # Sentry auth token for release deploys / source maps
SENTRY_ORG=                 # Sentry organisation slug
SENTRY_PROJECT=             # Sentry project slug (e.g. estalara-ingest)

# ── Grafana / OpenTelemetry ───────────────────────────────────────────────────
# Provisioned in TICKET-003.
GRAFANA_CLOUD_INSTANCE_ID=  # Grafana Cloud stack instance ID
GRAFANA_CLOUD_API_KEY=      # Grafana Cloud API key
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-0.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS= # e.g. Authorization=Basic <base64-encoded-credentials>

# ── Doppler ───────────────────────────────────────────────────────────────────
# Only needed in CI; locally, `doppler run` injects secrets automatically.
DOPPLER_TOKEN=              # Doppler service token for the target environment

# ── Feature gates ─────────────────────────────────────────────────────────────
# FOLLOW-346: Chat NLP live-adaptation gate (C-07 DPIA).
# Default false = shadow-only (intent vector written to Redis, returned to SDK
# for applyChatIntentPrior only; directives are unaffected).
# Set to true ONLY after all 5 C-07 DPIA go-live items are signed off by CEO + DPO.
CHAT_NLP_LIVE=false

# ── Modal chat-NLP direct invoke (audit F-01 / ADR-0016 pattern) ──────────────
# Ingest POSTs chat.message.sent to this URL (bypasses Redpanda/stream-consumer).
# Provision after `modal deploy` of apps/intent-engine (chat_nlp_endpoint).
# Also set as Cloudflare Worker secrets on apps/ingest (wrangler secret put).
MODAL_CHAT_NLP_URL=                # e.g. https://<workspace>--estalara-intent-engine-chat-nlp-endpoint.modal.run

# ── Canonical service URLs (packages/shared/src/domains.ts) ──────────────────
# Canonical domain: estalara.com — per DECISIONS_2026-05-18_v2.
# These are config values (not secrets); safe to commit to Doppler as plain text.
ESTALARA_INGEST_URL=https://ingest.estalara.com            # Cloudflare Worker
ESTALARA_DECISION_API_URL=https://decision.estalara.com         # Cloudflare Worker
NEXT_PUBLIC_CONTROL_PLANE_URL=https://admin.estalara.com   # Next.js/Vercel
NEXT_PUBLIC_SDK_CDN_URL=https://cdn.estalara.com           # Cloudflare R2 CDN
ESTALARA_SDK_CDN_URL=https://cdn.estalara.com              # Server-side alias

# ── Adapt feedback endpoint interim disable (ESC-035 / FOLLOW-444) ───────────
# Secure-by-default: POST /api/adapt/feedback returns 503 unless explicitly enabled.
# No operator action required to stay safe; enabling requires deliberate opt-in.
# Set FEEDBACK_ENDPOINT_ENABLED=true ONLY after FOLLOW-443 HMAC fix ships.
# REMOVE both vars when FOLLOW-443 ships and the 503 block is gone.
FEEDBACK_ENDPOINT_ENABLED=         # unset or empty = disabled (503); 'true' = enabled
# UUID of the single ops tenant permitted to write via the ADAPT_API_KEY bypass.
# Must be a real UUID (e.g. from the tenants table). Required when ADAPT_API_KEY is set.
OPS_TENANT_ID=                     # e.g. 00000000-0000-0000-0000-000000000000

# ── Modal embed-seed consumer (FOLLOW-435 LEG 2) ─────────────────────────────
# Used by apps/llm-gateway/src/jobs/consume_embed_seed_requests.py to call
# POST /api/listings/embed for each listing_id in a seed event.
# Also read by the TS producer in apps/control-plane/src/lib/listing-embed-seed-publisher.ts.
REDPANDA_TOPIC_LISTING_EMBEDDINGS=estalara.listing-embeddings  # Topic for overflow embed-seed events (default: estalara.listing-embeddings)
EMBED_API_BASE_URL=https://admin.estalara.com              # Control-plane base URL (no trailing slash)
INTERNAL_API_SECRET=                                       # Shared secret for x-internal-api-secret header

# ── Modal description-cache Postgres write (FOLLOW-460) ──────────────────────
# Used by apps/llm-gateway/src/jobs/generate_description.py to call
# POST /api/internal/description-cache after generation, writing the durable
# description_cache_persistent Postgres row (Master Design §E.7 v2.0).
# Also read by apps/control-plane/src/app/api/internal/description-cache/route.ts.
DESCRIPTION_CACHE_API_BASE_URL=https://admin.estalara.com  # Control-plane base URL (no trailing slash)
DESCRIPTION_CACHE_INTERNAL_SECRET=                         # Shared secret for the internal endpoint's Bearer auth
