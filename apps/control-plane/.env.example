# Estalara Control Plane — environment variables
# Copy this file to .env.local and fill in the values.
# All secrets are managed via Doppler in CI/production.

# ──────────────────────────────────────────────────
# Next.js
# ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ──────────────────────────────────────────────────
# Sentry (optional — skipped gracefully if absent)
# ──────────────────────────────────────────────────
SENTRY_DSN_CONTROL_PLANE=
SENTRY_ORG=
SENTRY_PROJECT=

# ──────────────────────────────────────────────────
# Supabase (filled in when TICKET-020 lands)
# ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ──────────────────────────────────────────────────
# Database (filled in when TICKET-020 lands)
# ──────────────────────────────────────────────────
DATABASE_URL=

# ──────────────────────────────────────────────────
# Auth (filled in when TICKET-024 lands)
# ──────────────────────────────────────────────────
JWT_SECRET=
API_KEY_HMAC_SECRET=

# ──────────────────────────────────────────────────
# Stripe (filled in when TICKET-029 lands)
# ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ──────────────────────────────────────────────────
# Resend (email delivery)
# ──────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key_here

# ──────────────────────────────────────────────────
# Build info (injected by CI)
# ──────────────────────────────────────────────────
GIT_SHA=
NODE_ENV=development
