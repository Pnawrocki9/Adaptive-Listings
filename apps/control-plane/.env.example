# Estalara Control Plane — environment variables
# Copy this file to .env.local and fill in the values.
# All secrets are managed via Doppler in CI/production.

# ──────────────────────────────────────────────────
# Next.js
# ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Canonical service URLs — production values in Doppler
NEXT_PUBLIC_CONTROL_PLANE_URL=https://admin.estalara.com
NEXT_PUBLIC_SDK_CDN_URL=https://cdn.estalara.com
ESTALARA_INGEST_URL=https://ingest.estalara.com
# Estalara product backend (listing-details API) — source of a listing's original
# description for the description/headline pipeline (ESC-018). Dev default: http://localhost:8081
# MUST be the direct Spring Boot URL, NOT app.estalara.com (SvelteKit frontend intercepts
# /api/v1/... with auth guard even though Spring Security has permitAll() — ESC-019).
# Host renamed api.estalara.com -> api.app.estalara.com ~2026-06-30 (FOLLOW-568).
#
# LOCALHOST (FOLLOW-819 harness / FOLLOW-1225): ESTALARA_BACKEND_URL=http://localhost:8081, with
# `node scripts/dev/fixture-listing-details-server.mjs` serving the fixture page's own facts there
# (tests/e2e/follow-819/README.md §3.3b). It is NOT in Doppler `dev`, so leaving it unset on
# localhost falls back to http://localhost:8081 with nothing listening: fetchListingJson() logs
# `[listing-details] fetch failed`, hasListingFacts() is false, groundingMissing is true, and every
# adapted response comes back `playbook_fallback_llm_unavailable` / `listing_context_unavailable`
# with `outcomes.adapted: 0` — i.e. FOLLOW-820 condition 1 clause 1 cannot pass. Measured 2026-09-20
# at 241e762b (README §5.10).
ESTALARA_BACKEND_URL=https://api.app.estalara.com

# ──────────────────────────────────────────────────
# Sentry (optional — skipped gracefully if absent)
# ──────────────────────────────────────────────────
SENTRY_DSN_CONTROL_PLANE=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=               # Sentry source-map upload token (set in CI/Doppler; skipped gracefully when absent)

# ──────────────────────────────────────────────────
# Supabase — REQUIRED for /sign-in auth flow (FOLLOW-326)
# ──────────────────────────────────────────────────
# Both vars are REQUIRED — the /sign-in page will throw at runtime if either is absent.
# Production project: yhmivuqeqkmzpxpyrsvc (eu-west-3, supabase.co)
# Set NEXT_PUBLIC_SUPABASE_ANON_KEY from Doppler prd secret of the same name.
# Operator action after merge: add both vars to Vercel prod env and redeploy.
NEXT_PUBLIC_SUPABASE_URL=https://yhmivuqeqkmzpxpyrsvc.supabase.co  # REQUIRED — Supabase project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here                    # REQUIRED — from Doppler prd NEXT_PUBLIC_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=

# ──────────────────────────────────────────────────
# Database (filled in when TICKET-020 lands)
# ──────────────────────────────────────────────────
DATABASE_URL=

# ──────────────────────────────────────────────────
# Auth
# ──────────────────────────────────────────────────
JWT_SECRET=
API_KEY_HMAC_SECRET=
ADMIN_API_SECRET=                   # Internal admin-only API secret
INTERNAL_API_SECRET=                # Shared secret for service-to-service calls (seed scripts, Modal workers)
DEMO_MODE_JWT_SECRET=               # Must be set — NO fallback in production (see B12)
# FOLLOW-374: platform-wide registration consent endpoint (POST /api/v1/consent/platform-registration)
PLATFORM_REGISTRATION_CONSENT_SECRET=  # HMAC-SHA256 shared secret; caller (app.estalara.com) signs body; REQUIRED — missing key → 401 all requests
CONSENT_IP_ENCRYPTION_KEY=             # 64-char hex (32 bytes) AES-256-GCM key for ip_address encryption; absent → ip stored as null (not plaintext)
DEMO_TENANT_ID=                     # UUID of the demo / 000-app-estalara tenant (used by seed:listings)
# FOLLOW-654: first-party tenant allowlist for the consent_text_hash requirement.
# UNSET → all tenants treated as first-party (preserves the single-tenant live flow).
# MUST be set to the Estalara tenant UUID before onboarding any external brand, so
# non-first-party registrations are required to supply their own consent_text_hash.
FIRST_PARTY_TENANT_ID=              # UUID of the first-party Estalara tenant (see FOLLOW-654 / FOLLOW-656)

# ──────────────────────────────────────────────────
# Stripe (filled in when TICKET-029 lands)
# ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ──────────────────────────────────────────────────
# Resend (email delivery)
# ──────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key_here

# ──────────────────────────────────────────────────
# ClickHouse (deferred to Phase 2 — set before /api/dashboard/analytics/* activates)
# ──────────────────────────────────────────────────
CLICKHOUSE_URL=                     # e.g. https://abc123.eu-central-1.aws.clickhouse.cloud:8443
CLICKHOUSE_PASSWORD=                # ClickHouse service account password

# FOLLOW-560. 'true' makes logDecisionAsync write adaptation_decisions.scoring_path
# (cosine | djb2_fallback | djb2_guard | not_applicable). Since FOLLOW-1202 only 'cosine'
# means a reorder was served; the two djb2_* values mean it was withheld (the decision row's
# features_snapshot.reorder_withheld carries the reason code on every deployment).
#
# LOCALHOST SUBSTRATE (FOLLOW-1202): 'true'. The FOLLOW-819 bring-up applies migration 0022
# to the local ClickHouse (migrate.sh) and its harness AC(3) reads this column, so the value
# below is the one a localhost control plane runs with (tests/e2e/follow-819/README.md §3.4
# passes it explicitly, because Doppler dev does not define it).
#
# ANY OTHER INSTANCE: leave UNSET until migration 0022 has actually been applied to the
# instance CLICKHOUSE_URL points at. ClickHouse rejects an INSERT naming an unknown column and
# that rejection is only console.error'd, so flipping this early loses every decision row
# silently (ESC-031). Prod: an operator flips it in Doppler prd only after applying 0022
# there, which is deferred to FOLLOW-820.
SCORING_PATH_COLUMN_ENABLED=true    # localhost substrate; unset wherever 0022 is not live

# ──────────────────────────────────────────────────
# Redpanda (deferred to Phase 2 — set before /api/demo/ingest activates)
# ──────────────────────────────────────────────────
REDPANDA_REST_URL=                  # Pandaproxy REST URL
REDPANDA_REST_USERNAME=
REDPANDA_REST_PASSWORD=
REDPANDA_TOPIC_EVENTS=estalara.events
REDPANDA_TOPIC_DESCRIPTIONS=estalara.descriptions
REDPANDA_TOPIC_LISTING_EMBEDDINGS=estalara.listing-embeddings

# ──────────────────────────────────────────────────
# Modal direct-invocation web endpoints (ADR-0016 / FOLLOW-485)
#
# The prod Redpanda cluster is Serverless, whose HTTP Proxy is BYOC/Dedicated-only
# (out of pilot budget), so the description + embed-seed pipelines no longer publish
# to Redpanda topics (REDPANDA_TOPIC_DESCRIPTIONS / REDPANDA_TOPIC_LISTING_EMBEDDINGS
# above are unused by these two flows as a result). Instead the control-plane POSTs
# the event JSON directly to Modal's authenticated web endpoints, obtained after
# `modal deploy apps/llm-gateway/src/main.py` (they end in `.modal.run`).
# INTERNAL_API_SECRET (above) is reused as the `Authorization: Bearer` value.
# ──────────────────────────────────────────────────
MODAL_DESCRIPTION_URL=               # e.g. https://<workspace>--estalara-description-generator-description-requested-endpoint.modal.run
MODAL_EMBED_SEED_URL=                # e.g. https://<workspace>--estalara-description-generator-embed-seed-requested-endpoint.modal.run
# Chat-NLP lives on the ingest Worker (F-01), not control-plane — see root .env.example MODAL_CHAT_NLP_URL.

# ──────────────────────────────────────────────────
# Upstash Redis (deferred to Phase 2)
# ──────────────────────────────────────────────────
UPSTASH_REDIS_URL=                  # https://<db>.upstash.io
UPSTASH_REDIS_TOKEN=

# ──────────────────────────────────────────────────
# LLM / AI
# ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ADAPT_API_KEY=                      # Bearer token for /api/adapt/* internal calls
# ── A/B holdout (FOLLOW-1201 / audit SEC-4) ──────────────────────────────────
# REQUIRED. HMAC key assignHoldout() buckets sessions with (>= 32 chars, CSPRNG). Never a value
# on the page. Missing → every /api/adapt is 500 holdout_secret_unconfigured (fail loud, never
# a fallback to public keying). Rotating it re-buckets EVERY session — only at a window boundary.
HOLDOUT_ASSIGNMENT_SECRET=
# Configured holdout rate in [0, 1]. Unset = 0.1. A body `holdout_pct` is honoured ONLY for a
# caller whose bearer is ADAPT_API_KEY (the FOLLOW-819 harness control arm); everyone else gets
# this value. An unparseable value is a 500 holdout_config_invalid, not a silent 0.1.
HOLDOUT_PCT=
SCHEMA_API_TOKEN=                   # Bearer token for /api/internal/schema

# ──────────────────────────────────────────────────
# Billing
# ──────────────────────────────────────────────────
LISTING_UPDATED_WEBHOOK_SECRET=     # Stripe or MLS listing-updated webhook HMAC secret
STRIPE_PRICE_OBSERVER=              # Stripe price ID for Observer tier
STRIPE_PRICE_AUGMENT=               # Stripe price ID for Augment tier
STRIPE_PRICE_NATIVE=                # Stripe price ID for Native tier

# ──────────────────────────────────────────────────
# Database (extended)
# ──────────────────────────────────────────────────
DATABASE_URL_ADMIN=                 # Postgres URL with admin role (migrations)
DATABASE_URL_DIRECT=                # Direct Postgres URL (bypasses pgBouncer)

# ──────────────────────────────────────────────────
# Vercel Cron
# ──────────────────────────────────────────────────
# Vercel automatically injects Authorization: Bearer <CRON_SECRET> for
# cron-triggered invocations. Must match the CRON_SECRET value configured
# in the Vercel project settings. Requests are rejected with 401 when
# this variable is unset (infrastructure misconfiguration).
CRON_SECRET=your-vercel-cron-secret-here  # Must match Vercel project CRON_SECRET setting

# ──────────────────────────────────────────────────
# Build info (injected by CI)
# ──────────────────────────────────────────────────
GIT_SHA=
NEXT_PUBLIC_GIT_SHA=                # Exposed to browser for footer/debug
NEXT_PUBLIC_SENTRY_DSN_CONTROL_PLANE=
NODE_ENV=development
