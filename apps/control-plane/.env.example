# Estalara Control Plane — environment variables
# Copy this file to .env.local and fill in the values.
# All secrets are managed via Doppler in CI/production.

# ──────────────────────────────────────────────────
# Next.js
# ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Canonical service URLs — production values in Doppler
NEXT_PUBLIC_CONTROL_PLANE_URL=https://admin.estalara.com
NEXT_PUBLIC_SDK_CDN_URL=https://cdn.estalara.com
ESTALARA_INGEST_URL=https://ingest.estalara.com
ESTALARA_DECISION_API_URL=https://decision.estalara.com

# ──────────────────────────────────────────────────
# Sentry (optional — skipped gracefully if absent)
# ──────────────────────────────────────────────────
SENTRY_DSN_CONTROL_PLANE=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=               # Sentry source-map upload token (set in CI/Doppler; skipped gracefully when absent)

# ──────────────────────────────────────────────────
# Supabase (filled in when TICKET-020 lands)
# ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ──────────────────────────────────────────────────
# Database (filled in when TICKET-020 lands)
# ──────────────────────────────────────────────────
DATABASE_URL=

# ──────────────────────────────────────────────────
# Auth
# ──────────────────────────────────────────────────
JWT_SECRET=
API_KEY_HMAC_SECRET=
ADMIN_API_SECRET=                   # Internal admin-only API secret
INTERNAL_API_SECRET=                # Shared secret for service-to-service calls (seed scripts, Modal workers)
DEMO_MODE_JWT_SECRET=               # Must be set — NO fallback in production (see B12)
DEMO_TENANT_ID=                     # UUID of the demo / 000-app-estalara tenant (used by seed:listings)

# ──────────────────────────────────────────────────
# Stripe (filled in when TICKET-029 lands)
# ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ──────────────────────────────────────────────────
# Resend (email delivery)
# ──────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key_here

# ──────────────────────────────────────────────────
# ClickHouse (deferred to Phase 2 — set before /api/dashboard/analytics/* activates)
# ──────────────────────────────────────────────────
CLICKHOUSE_URL=                     # e.g. https://abc123.eu-central-1.aws.clickhouse.cloud:8443
CLICKHOUSE_PASSWORD=                # ClickHouse service account password

# ──────────────────────────────────────────────────
# Redpanda (deferred to Phase 2 — set before /api/demo/ingest activates)
# ──────────────────────────────────────────────────
REDPANDA_REST_URL=                  # Pandaproxy REST URL
REDPANDA_REST_USERNAME=
REDPANDA_REST_PASSWORD=
REDPANDA_TOPIC_EVENTS=estalara.events
REDPANDA_TOPIC_DESCRIPTIONS=estalara.descriptions

# ──────────────────────────────────────────────────
# Upstash Redis (deferred to Phase 2)
# ──────────────────────────────────────────────────
UPSTASH_REDIS_URL=                  # https://<db>.upstash.io
UPSTASH_REDIS_TOKEN=

# ──────────────────────────────────────────────────
# LLM / AI
# ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ADAPT_API_KEY=                      # Bearer token for /api/adapt/* internal calls
SCHEMA_API_TOKEN=                   # Bearer token for /api/internal/schema

# ──────────────────────────────────────────────────
# Billing
# ──────────────────────────────────────────────────
LISTING_UPDATED_WEBHOOK_SECRET=     # Stripe or MLS listing-updated webhook HMAC secret
STRIPE_PRICE_OBSERVER=              # Stripe price ID for Observer tier
STRIPE_PRICE_AUGMENT=               # Stripe price ID for Augment tier
STRIPE_PRICE_NATIVE=                # Stripe price ID for Native tier

# ──────────────────────────────────────────────────
# Database (extended)
# ──────────────────────────────────────────────────
DATABASE_URL_ADMIN=                 # Postgres URL with admin role (migrations)
DATABASE_URL_DIRECT=                # Direct Postgres URL (bypasses pgBouncer)

# ──────────────────────────────────────────────────
# Vercel Cron
# ──────────────────────────────────────────────────
# Vercel automatically injects Authorization: Bearer <CRON_SECRET> for
# cron-triggered invocations. Must match the CRON_SECRET value configured
# in the Vercel project settings. Requests are rejected with 401 when
# this variable is unset (infrastructure misconfiguration).
CRON_SECRET=your-vercel-cron-secret-here  # Must match Vercel project CRON_SECRET setting

# ──────────────────────────────────────────────────
# Build info (injected by CI)
# ──────────────────────────────────────────────────
GIT_SHA=
NEXT_PUBLIC_GIT_SHA=                # Exposed to browser for footer/debug
NEXT_PUBLIC_SENTRY_DSN_CONTROL_PLANE=
NODE_ENV=development
