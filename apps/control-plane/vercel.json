{
  "framework": "nextjs",
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=@estalara/control-plane",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "outputDirectory": ".next",
  "regions": ["cdg1"],
  "crons": [
    {
      "path": "/api/dsr/mutation-poll",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/internal/retention/conversion-labels",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/internal/retention/consent-log",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/canary/adaptation-writes",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/lift-snapshot",
      "schedule": "15 1 * * *"
    },
    {
      "path": "/api/cron/quiz-accuracy-watch",
      "schedule": "30 3 1 * *"
    }
  ]
}
