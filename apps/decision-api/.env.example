# =============================================================================
# apps/decision-api — Environment Variables Reference
# =============================================================================
# Cloudflare Worker vars are configured in wrangler.toml [vars] for
# non-secret values, and via `wrangler secret put` (or Doppler) for secrets.
# =============================================================================

# ── Auth ──────────────────────────────────────────────────────────────────────
# When set, POST /api/adapt requires this exact value as the Bearer token.
# Leave empty for local dev / tests (presence-only auth is used when unset).
ADAPT_API_KEY=

# ── LLM spend cap ─────────────────────────────────────────────────────────────
# Per-tenant daily LLM spend cap in USD.
# Requests exceeding the cap fall back to the static playbook and return
# source: 'playbook_fallback_llm_capped' in the response.
# Sprint 9 replaces the in-memory counter with Upstash Redis for cross-instance tracking.
LLM_DAILY_CAP_USD=1.00
