# =============================================================================
# apps/ingest — Environment Variables Reference
# =============================================================================
# Ingest is a Cloudflare Worker. Non-secret vars are configured in wrangler.toml
# [vars]; secrets are set via `wrangler secret put` (or Doppler in CI).
# This file documents all vars for local dev (wrangler dev) and Doppler setup.
# =============================================================================

# ── Canonical service URL ─────────────────────────────────────────────────────
# This worker's own URL — used in runbooks and SDK default config.
# ESTALARA_INGEST_URL=https://ingest.estalara.com

# ── Redpanda REST proxy (Pandaproxy) ─────────────────────────────────────────
# Set as wrangler env binding in wrangler.toml [env.staging.vars] / [env.production.vars].
# For local dev: point at local Redpanda or leave empty to skip event forwarding.
REDPANDA_REST_URL=http://localhost:8082
REDPANDA_TOPIC_EVENTS=estalara.events

# ── Observability ─────────────────────────────────────────────────────────────
# Set as Worker secrets via `wrangler secret put` — never in wrangler.toml.
SENTRY_DSN_INGEST=              # Sentry DSN for the ingest Worker project
OTEL_EXPORTER_HEADERS=          # e.g. Authorization=Basic <base64> for Grafana Cloud OTLP
OTEL_EXPORTER_URL=              # Grafana Cloud OTLP endpoint

# ── Cloudflare KV namespace IDs ───────────────────────────────────────────────
# Provisioned via `wrangler kv namespace create` or `terraform apply`.
# Substitute into wrangler.toml [[kv_namespaces]] before deploying.
KV_API_KEYS_ID=                 # wrangler kv namespace create KV_API_KEYS → id
KV_API_KEYS_PREVIEW_ID=         # preview_id for wrangler dev
KV_IDEMPOTENCY_ID=              # wrangler kv namespace create KV_IDEMPOTENCY → id
KV_IDEMPOTENCY_PREVIEW_ID=      # preview_id for wrangler dev
