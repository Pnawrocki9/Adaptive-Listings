@@ -0,0 +1,96 @@
+package com.time2show.core.service.adaptivelistings
+
+import java.net.URI
+import java.net.http.HttpClient
+import java.net.http.HttpRequest
+import java.net.http.HttpResponse
+import java.nio.charset.StandardCharsets
+import java.time.Duration
+import java.util.concurrent.ExecutionException
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.TimeoutException
+
+/**
+ * One best-effort POST to Adaptive Listings: a bounded number of sends, each bounded as a whole, with a
+ * re-send only after a 5xx, a 429 or a network failure. Never on a request thread. Worst case is
+ * MAX_SENDS x request timeout + (MAX_SENDS - 1) x MAX_RETRY_AFTER.
+ */
+class BoundedHttpPost(
+    connectTimeout: Duration,
+    private val requestTimeout: Duration,
+    private val retryDelay: Duration,
+) {
+    // HTTP/1.1 is pinned: the JDK client otherwise tries an h2c upgrade on plain http, which `wrangler
+    // dev` and a proxy in front of the control plane have no reason to be asked about.
+    private val client: HttpClient = HttpClient.newBuilder()
+        .version(HttpClient.Version.HTTP_1_1)
+        .connectTimeout(connectTimeout)
+        .build()
+
+    /** How the last send ended. [status] is null when no complete response arrived. */
+    data class Outcome(
+        val status: Int?,
+        val body: String?,
+        val sends: Int,
+        val failure: String?,
+        val retryAfter: Duration? = null,
+    )
+
+    /** [headers] is called once per send, so a signed caller signs each send freshly. */
+    fun post(uri: URI, body: String, headers: () -> Map<String, String>): Outcome {
+        var last = Outcome(null, null, 0, "not_sent")
+        for (send in 1..MAX_SENDS) {
+            last = sendOnce(uri, body, headers(), send)
+            val status = last.status
+            val retryable = status == null || status >= 500 || status == 429
+            if (!retryable || send == MAX_SENDS) return last
+
+            val wait = last.retryAfter ?: retryDelay
+            // Sending earlier than the server asked is pointless, and waiting longer breaks the bound.
+            if (wait > MAX_RETRY_AFTER) return last.copy(failure = "retry_after_beyond_bound")
+            try {
+                Thread.sleep(wait.toMillis())
+            } catch (e: InterruptedException) {
+                Thread.currentThread().interrupt()
+                return last
+            }
+        }
+        return last
+    }
+
+    private fun sendOnce(uri: URI, body: String, headers: Map<String, String>, send: Int): Outcome {
+        val builder = HttpRequest.newBuilder(uri)
+            .timeout(requestTimeout)
+            .POST(HttpRequest.BodyPublishers.ofString(body, StandardCharsets.UTF_8))
+        headers.forEach { (name, value) -> builder.header(name, value) }
+        // A deadline on the whole exchange, body included, stated here rather than left to how a given JDK
+        // build reads `HttpRequest.timeout`: its contract is "the response", and builds differ on the body.
+        val exchange = client.sendAsync(builder.build(), HttpResponse.BodyHandlers.ofString(StandardCharsets.UTF_8))
+        return try {
+            val response = exchange.get(requestTimeout.toMillis(), TimeUnit.MILLISECONDS)
+            val retryAfter = response.headers().firstValue("Retry-After").orElse(null)
+                ?.takeIf { response.statusCode() == 429 }
+                ?.let(::parseRetryAfter)
+            Outcome(response.statusCode(), response.body(), send, null, retryAfter)
+        } catch (e: TimeoutException) {
+            exchange.cancel(true)
+            Outcome(null, null, send, "timeout")
+        } catch (e: ExecutionException) {
+            // The class name only: a message can carry the URL, and the log needs no more than the kind.
+            Outcome(null, null, send, (e.cause ?: e).javaClass.simpleName)
+        } catch (e: InterruptedException) {
+            exchange.cancel(true)
+            Thread.currentThread().interrupt()
+            Outcome(null, null, send, "interrupted")
+        }
+    }
+
+    /** Delay-seconds only; ingest sends that form. An HTTP-date falls back to the ordinary delay. */
+    private fun parseRetryAfter(raw: String): Duration? =
+        raw.trim().toLongOrNull()?.takeIf { it >= 0 }?.let { Duration.ofSeconds(it) }
+
+    companion object {
+        const val MAX_SENDS = 3
+        val MAX_RETRY_AFTER: Duration = Duration.ofSeconds(10)
+    }
+}
