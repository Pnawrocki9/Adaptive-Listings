+package com.time2show.core.unit.service.adaptivelistings
+
+import ch.qos.logback.classic.Logger
+import ch.qos.logback.classic.spi.ILoggingEvent
+import ch.qos.logback.core.read.ListAppender
+import com.time2show.core.service.adaptivelistings.AdaptiveListingsProperties
+import com.time2show.core.service.adaptivelistings.BuyerSessionId
+import com.time2show.core.service.adaptivelistings.ConversionEventClient
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.DisplayName
+import org.junit.jupiter.api.Tag
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable
+import org.slf4j.LoggerFactory
+import java.time.Duration
+import java.util.UUID
+
+/**
+ * The real emitter against a real running ingest Worker. Skipped unless `AL_LIVE_INGEST_URL` is set;
+ * the caller then reads ClickHouse for `AL_LIVE_SESSION_ID` and expects both rows with
+ * `caller_signed = 1`. See docs/handover/estalara-app-patches/README.md.
+ */
+@DisplayName("ConversionEventClient against a live ingest")
+@Tag("unit")
+@EnabledIfEnvironmentVariable(named = "AL_LIVE_INGEST_URL", matches = ".+")
+class ConversionEventLiveIngestTest {
+
+    @Test
+    fun `both conversions are accepted by the running Worker`() {
+        val appender = ListAppender<ILoggingEvent>().apply { start() }
+        val logger = LoggerFactory.getLogger(ConversionEventClient::class.java) as Logger
+        logger.addAppender(appender)
+        try {
+            val client = ConversionEventClient(
+                AdaptiveListingsProperties(
+                    System.getenv("AL_LIVE_INGEST_URL"),
+                    System.getenv("AL_LIVE_API_KEY"),
+                    System.getenv("AL_LIVE_HMAC_SECRET"),
+                    "", "", "",
+                    Duration.ofSeconds(2), Duration.ofSeconds(10), Duration.ofMillis(750)
+                )
+            )
+            val session = BuyerSessionId.parse(System.getenv("AL_LIVE_SESSION_ID"))!!
+
+            client.sendLiveSignup(session, UUID.randomUUID(), UUID.fromString(SignedEventVectors.LISTING_ID))
+            client.sendInquiryCompleted(session)
+
+            val lines = appender.list.map { it.formattedMessage }
+            assertEquals(2, lines.count { it.startsWith("al_conversion_sent") }, lines.joinToString("\n"))
+        } finally {
+            logger.detachAppender(appender)
+        }
+    }
+}
