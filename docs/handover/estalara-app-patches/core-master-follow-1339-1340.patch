+    @field:MockitoBean private lateinit var storeService: StoreService
+    @field:MockitoBean private lateinit var listingTranslationService: ListingTranslationService
+    @field:MockitoBean private lateinit var notificationService: NotificationService
+    @field:MockitoBean private lateinit var scrapingWebhookService: ScrapingWebhookService
+    @field:MockitoBean private lateinit var chatModel: ChatModel
+    @field:MockitoBean private lateinit var vectorStore: VectorStore
+
+    @BeforeEach
+    fun setUp() {
+        whenever(storeService.buildPublicPhotoUrl(any())).thenReturn("https://test/image.jpg")
+        whenever(storeService.buildPublicVideoUrl(any())).thenReturn("https://test/video.mp4")
+    }
+
+    private fun jobsFor(listingUuid: UUID): List<AsyncJobEntity> =
+        asyncJobRepository.findAll().filter {
+            it.type == AsyncJobType.LISTING_UPDATED_WEBHOOK && it.aggregateId == listingUuid.toString()
+        }
+
+    private fun managedListing(): Pair<ListingEntity, String> {
+        val login = "listing-webhook-${UUID.randomUUID().toString().take(8)}"
+        val agent = listingDataFactory.createAgentWithProfile(login)
+        return calendarDataFactory.createManagedListing(agent) to authUtils.createBearerToken(login, listOf(UserRole.AGENT))
+    }
+
+    private fun patchListing(token: String, body: PatchOwnListingRequestTO) = mockMvc.perform(
+        patch("/api/v1/listing")
+            .header("Authorization", "Bearer $token")
+            .contentType(MediaType.APPLICATION_JSON)
+            .content(objectMapper.writeValueAsString(body))
+    )
+
+    @Test
+    @Transactional
+    fun `a price PATCH writes one job in the save's transaction`() {
+        val (listing, token) = managedListing()
+
+        patchListing(token, PatchOwnListingRequestTO(listingUuid = listing.uuid.toString(), status = listing.status, price = 123_456.0))
+            .andExpect(status().isOk)
+
+        val job = jobsFor(listing.uuid).single()
+        assertEquals(AsyncAggregateType.LISTING, job.aggregateType)
+        assertEquals(12, job.maxAttempts)
+    }
+
+    @Test
+    @Transactional
+    fun `a PATCH that only repeats the status writes no job`() {
+        val (listing, token) = managedListing()
+        listing.status = ListingStatus.ACTIVE
+        listingRepository.saveAndFlush(listing)
+
+        patchListing(token, PatchOwnListingRequestTO(listingUuid = listing.uuid.toString(), status = ListingStatus.ACTIVE))
+            .andExpect(status().isOk)
+
+        assertEquals(0, jobsFor(listing.uuid).size)
+    }
+
+    @Test
+    @Transactional
+    fun `re-publishing a DRAFT writes a job, the case a re-scrape leaves behind`() {
+        val (listing, token) = managedListing()
+        listing.status = ListingStatus.DRAFT
+        listingRepository.saveAndFlush(listing)
+
+        patchListing(token, PatchOwnListingRequestTO(listingUuid = listing.uuid.toString(), status = ListingStatus.ACTIVE))
+            .andExpect(status().isOk)
+
+        assertEquals(1, jobsFor(listing.uuid).size)
+    }
+
+    @Test
+    @Transactional
+    fun `a refused PATCH writes no job`() {
+        val (_, token) = managedListing()
+        val unknown = UUID.randomUUID()
+
+        patchListing(token, PatchOwnListingRequestTO(listingUuid = unknown.toString(), status = ListingStatus.ACTIVE, price = 1.0))
+            .andExpect(status().isNotFound)
+
+        assertEquals(0, jobsFor(unknown).size)
+    }
+
+    @Test
+    fun `the job survives a control plane that is down and delivers once it answers`() {
+        val listingUuid = UUID.randomUUID()
+        webhookStatus = 503
+        val job = asyncJobCreator.createJob(
+            type = AsyncJobType.LISTING_UPDATED_WEBHOOK,
+            aggregateType = AsyncAggregateType.LISTING,
+            aggregateId = listingUuid.toString(),
+            payloadJson = objectMapper.writeValueAsString(ListingUpdatedWebhookJobPayload(listingUuid.toString())),
+        )
+        try {
+            val failed = await(job.id!!) { it.status == AsyncJobStatus.RETRY_WAIT }
+            assertEquals(1, failed.attemptCount)
+            assertNotNull(failed.lastError)
+            assertFalse(failed.lastError!!.contains(WEBHOOK_SECRET))
+
+            // What the poller does when the backoff has passed; the wait itself is not worth a test's time.
+            webhookStatus = 200
+            failed.nextAttemptAt = Instant.now().minusSeconds(1)
+            asyncJobRepository.saveAndFlush(failed)
+            dispatcher.submitPendingForAllTypes()
+
+            val delivered = await(job.id!!) { it.status == AsyncJobStatus.SUCCEEDED }
+            assertEquals(1, delivered.attemptCount)
+            val body = objectMapper.readTree(webhookBodies.last { it.contains(listingUuid.toString()) })
+            assertEquals(TENANT_ID, body["tenant_id"].asText())
+            assertEquals(listingUuid.toString(), body["listing_id"].asText())
+        } finally {
+            asyncJobRepository.deleteById(job.id!!)
+        }
+    }
+
+    private fun await(jobId: Long, predicate: (AsyncJobEntity) -> Boolean): AsyncJobEntity {
+        val deadline = System.nanoTime() + java.time.Duration.ofSeconds(60).toNanos()
+        while (System.nanoTime() < deadline) {
+            val current = asyncJobRepository.findById(jobId).orElseThrow()
+            if (predicate(current)) return current
+            Thread.sleep(100)
+        }
+        val last = asyncJobRepository.findById(jobId).orElseThrow()
+        throw AssertionError("job $jobId stayed ${last.status} attempts=${last.attemptCount} error=${last.lastError}")
+    }
+
+    companion object {
+        private const val WEBHOOK_SECRET = "integration-webhook-value"
+        private const val TENANT_ID = "00000000-0000-0000-0000-0000000000e2"
+
+        @Volatile
+        private var webhookStatus = 200
+        private val webhookBodies = CopyOnWriteArrayList<String>()
+
+        private val server: HttpServer = HttpServer.create(InetSocketAddress("127.0.0.1", 0), 0).apply {
+            createContext("/api/webhooks/listing-updated") { exchange ->
+                webhookBodies += exchange.requestBody.readAllBytes().toString(Charsets.UTF_8)
+                exchange.sendResponseHeaders(webhookStatus, -1)
+                exchange.close()
+            }
+            start()
+        }
+
+        @JvmStatic
+        @DynamicPropertySource
+        fun properties(registry: DynamicPropertyRegistry) {
+            registry.add("adaptive-listings.listing-updated-webhook-url") {
+                "http://127.0.0.1:${server.address.port}/api/webhooks/listing-updated"
+            }
+            registry.add("adaptive-listings.listing-updated-webhook-secret") { WEBHOOK_SECRET }
+            registry.add("adaptive-listings.tenant-id") { TENANT_ID }
+        }
+    }
+}
