+package com.time2show.core.service.adaptivelistings
+
+import com.fasterxml.jackson.databind.ObjectMapper
+import com.time2show.core.dto.PatchOwnListingRequestTO
+import org.slf4j.LoggerFactory
+import org.springframework.scheduling.annotation.Async
+import org.springframework.stereotype.Component
+
+/**
+ * Tells the Adaptive Listings control plane a listing was saved, so it advances the listing's revision
+ * and stops serving copy generated from the old facts (`POST /api/webhooks/listing-updated`).
+ *
+ * Called by the controller after the service returned, so the save has committed and the control
+ * plane's next read sees the new facts. A failed call leaves adapted copy stale; it is logged, and it
+ * never fails the save.
+ */
+@Component
+class ListingUpdatedNotifier(private val properties: AdaptiveListingsProperties) {
+
+    private val log = LoggerFactory.getLogger(ListingUpdatedNotifier::class.java)
+    private val objectMapper = ObjectMapper()
+    private val http = BoundedHttpPost(properties.connectTimeout, properties.requestTimeout, properties.retryDelay)
+
+    @Async
+    fun notifyListingSaved(listingUuid: String) {
+        val uri = properties.listingUpdatedUri
+        if (!properties.listingUpdatedConfigured || uri == null) {
+            log.debug("al_listing_updated_skipped reason=not_configured")
+            return
+        }
+        try {
+            val body = objectMapper.writeValueAsString(
+                mapOf("tenant_id" to properties.tenantId, "listing_id" to listingUuid)
+            )
+            val outcome = http.post(uri, body) {
+                mapOf("Content-Type" to "application/json", "X-Webhook-Secret" to properties.listingUpdatedWebhookSecret)
+            }
+            val status = outcome.status
+            if (status != null && status in 200..299) {
+                log.info("al_listing_updated_sent listing={} sends={}", listingUuid, outcome.sends)
+            } else {
+                log.warn(
+                    "al_listing_updated_failed listing={} sends={} status={} failure={}",
+                    listingUuid, outcome.sends, status, outcome.failure ?: "refused"
+                )
+            }
+        } catch (e: Exception) {
+            log.warn("al_listing_updated_failed listing={} failure={}", listingUuid, e.javaClass.simpleName)
+        }
+    }
+
+    companion object {
+        /**
+         * Whether a PATCH changed a fact adapted copy is grounded on (price, location). A photo reorder or
+         * a status change did not, and a regeneration on those would be paid for nothing.
+         */
+        fun changesGroundingFacts(request: PatchOwnListingRequestTO): Boolean =
+            request.price != null || request.cityPlaceGoogleId != null || request.districtPlaceGoogleId != null
+    }
+}
