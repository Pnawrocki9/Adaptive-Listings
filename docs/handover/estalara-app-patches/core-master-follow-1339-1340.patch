+import java.util.concurrent.CopyOnWriteArrayList
+
+@DisplayName("ListingUpdatedNotifier (unit, real HTTP)")
+@Tag("unit")
+class ListingUpdatedNotifierTest {
+
+    private val tenant = "00000000-0000-0000-0000-0000000000e2"
+    private val listing = "839ecbd1-4e7d-4fd9-bda7-37ceb27eaa1c"
+    private val secret = "webhook-test-value"
+
+    private lateinit var server: HttpServer
+    private val bodies = CopyOnWriteArrayList<String>()
+    private val secrets = CopyOnWriteArrayList<String?>()
+    private var status = 200
+
+    @BeforeEach
+    fun setUp() {
+        server = HttpServer.create(InetSocketAddress("127.0.0.1", 0), 0)
+        server.createContext("/api/webhooks/listing-updated") { exchange ->
+            bodies += exchange.requestBody.readAllBytes().toString(StandardCharsets.UTF_8)
+            secrets += exchange.requestHeaders.getFirst("X-Webhook-Secret")
+            exchange.sendResponseHeaders(status, -1)
+            exchange.close()
+        }
+        server.start()
+    }
+
+    @AfterEach
+    fun tearDown() = server.stop(0)
+
+    private fun notifier(url: String = "http://127.0.0.1:${server.address.port}/api/webhooks/listing-updated", key: String = secret) =
+        ListingUpdatedNotifier(
+            AdaptiveListingsProperties(
+                "", "", "", tenant, url, key,
+                Duration.ofSeconds(1), Duration.ofSeconds(1), Duration.ofMillis(5)
+            )
+        )
+
+    @Test
+    fun `a save posts the route's body with the route's secret header`() {
+        notifier().notifyListingSaved(listing)
+
+        assertEquals(1, bodies.size)
+        val body = ObjectMapper().readTree(bodies.single())
+        assertEquals(tenant, body["tenant_id"].asText())
+        assertEquals(listing, body["listing_id"].asText())
+        assertEquals(setOf("tenant_id", "listing_id"), body.fieldNames().asSequence().toSet())
+        assertEquals(secret, secrets.single())
+    }
+
+    @Test
+    fun `a 500 is re-sent up to the bound and does not throw`() {
+        status = 500
+        notifier().notifyListingSaved(listing)
+        assertEquals(BoundedHttpPost.MAX_SENDS, bodies.size)
+    }
+
+    @Test
+    fun `a 401 is not re-sent and does not throw`() {
+        status = 401
+        notifier().notifyListingSaved(listing)
+        assertEquals(1, bodies.size)
+    }
+
+    @Test
+    fun `an unreachable control plane does not throw`() {
+        val url = "http://127.0.0.1:${server.address.port}/api/webhooks/listing-updated"
+        server.stop(0)
+        notifier(url).notifyListingSaved(listing)
+    }
+
+    @Test
+    fun `not configured sends nothing`() {
+        notifier(url = "", key = "").notifyListingSaved(listing)
+        assertEquals(0, bodies.size)
+    }
+
+    @Test
+    fun `a PATCH bumps the revision only when it changes a grounded fact`() {
+        assertTrue(ListingUpdatedNotifier.changesGroundingFacts(PatchOwnListingRequestTO(listingUuid = listing, price = 1.0)))
+        assertTrue(ListingUpdatedNotifier.changesGroundingFacts(PatchOwnListingRequestTO(listingUuid = listing, cityPlaceGoogleId = "x")))
+        assertTrue(ListingUpdatedNotifier.changesGroundingFacts(PatchOwnListingRequestTO(listingUuid = listing, districtPlaceGoogleId = "x")))
+        assertFalse(ListingUpdatedNotifier.changesGroundingFacts(PatchOwnListingRequestTO(listingUuid = listing, imageUuids = listOf("x"))))
+        assertFalse(ListingUpdatedNotifier.changesGroundingFacts(PatchOwnListingRequestTO(listingUuid = listing)))
+    }
+}
