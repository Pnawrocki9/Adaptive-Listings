+package com.time2show.core.service.adaptivelistings
+
+import java.nio.charset.StandardCharsets
+import java.util.HexFormat
+import javax.crypto.Mac
+import javax.crypto.spec.SecretKeySpec
+
+/**
+ * The server-producer signature of `POST /v1/events` (MASTER_DESIGN V.3.2,
+ * `apps/ingest/src/auth.ts`):
+ * `hmac-sha256:` + lower-hex HMAC-SHA-256(hex-decode(secret), timestamp + "\n" + nonce + "\n" + body),
+ * over the UTF-8 bytes of the body exactly as sent.
+ */
+object SignedEventSigner {
+
+    const val PREFIX = "hmac-sha256:"
+
+    fun sign(secretHex: String, timestamp: String, nonce: String, body: String): String {
+        val mac = Mac.getInstance("HmacSHA256")
+        mac.init(SecretKeySpec(HexFormat.of().parseHex(secretHex), "HmacSHA256"))
+        val message = "$timestamp\n$nonce\n$body".toByteArray(StandardCharsets.UTF_8)
+        return PREFIX + HexFormat.of().formatHex(mac.doFinal(message))
+    }
+}
