+package com.time2show.core.service.adaptivelistings
+
+import org.slf4j.LoggerFactory
+import org.springframework.beans.factory.annotation.Autowired
+import org.springframework.beans.factory.annotation.Value
+import org.springframework.stereotype.Component
+import java.net.URI
+import java.time.Duration
+
+/**
+ * Adaptive Listings integration settings, from env only (see `application.properties`). Deliberately
+ * not a data class: a generated `toString` would print the two secrets.
+ *
+ * Every value empty means "not configured": nothing is sent, which is the state of a local run or a
+ * test that never set them. A partly set or malformed group is a deployment mistake and logs an error
+ * at startup, naming the setting and never its value, instead of quietly losing conversions.
+ */
+@Component
+class AdaptiveListingsProperties(
+    ingestUrl: String,
+    val serverApiKey: String,
+    val hmacSecretHex: String,
+    val tenantId: String,
+    listingUpdatedWebhookUrl: String,
+    val listingUpdatedWebhookSecret: String,
+    val connectTimeout: Duration,
+    val requestTimeout: Duration,
+    val retryDelay: Duration,
+) {
+    @Autowired
+    constructor(
+        @Value("\${adaptive-listings.ingest-url:}") ingestUrl: String,
+        @Value("\${adaptive-listings.server-api-key:}") serverApiKey: String,
+        @Value("\${adaptive-listings.hmac-secret:}") hmacSecretHex: String,
+        @Value("\${adaptive-listings.tenant-id:}") tenantId: String,
+        @Value("\${adaptive-listings.listing-updated-webhook-url:}") listingUpdatedWebhookUrl: String,
+        @Value("\${adaptive-listings.listing-updated-webhook-secret:}") listingUpdatedWebhookSecret: String,
+    ) : this(
+        ingestUrl, serverApiKey, hmacSecretHex, tenantId, listingUpdatedWebhookUrl, listingUpdatedWebhookSecret,
+        Duration.ofSeconds(2), Duration.ofSeconds(5), Duration.ofMillis(500),
+    )
+
+    private val log = LoggerFactory.getLogger(AdaptiveListingsProperties::class.java)
+
+    val eventsUri: URI? =
+        ingestUrl.trim().trimEnd('/').takeIf { it.isNotEmpty() }?.let { parseUri("$it/v1/events", "ingest-url") }
+    val listingUpdatedUri: URI? =
+        listingUpdatedWebhookUrl.trim().takeIf { it.isNotEmpty() }?.let { parseUri(it, "listing-updated-webhook-url") }
+
+    val eventsConfigured: Boolean = checkEvents()
+    val listingUpdatedConfigured: Boolean = checkListingUpdated()
+
+    private fun parseUri(raw: String, setting: String): URI? {
+        val uri = try {
+            URI.create(raw)
+        } catch (e: IllegalArgumentException) {
+            null
+        }
+        if (uri == null || (uri.scheme != "http" && uri.scheme != "https")) {
+            log.error("adaptive-listings.{} is not a valid http(s) URL", setting)
+            return null
+        }
+        return uri
+    }
+
+    private fun checkEvents(): Boolean {
+        val anySet = eventsUri != null || serverApiKey.isNotBlank() || hmacSecretHex.isNotBlank()
+        if (!anySet) {
+            log.info("Adaptive Listings conversion events are not configured; none will be sent")
+            return false
+        }
+        val hexOk = hmacSecretHex.length >= 2 && hmacSecretHex.length % 2 == 0 &&
+            hmacSecretHex.all { it in '0'..'9' || it in 'a'..'f' || it in 'A'..'F' }
+        if (eventsUri == null || serverApiKey.isBlank() || !hexOk) {
+            log.error(
+                "Adaptive Listings conversion events are misconfigured and disabled " +
+                    "(ingest-url set: {}, server-api-key set: {}, hmac-secret is hex: {})",
+                eventsUri != null, serverApiKey.isNotBlank(), hexOk
+            )
+            return false
+        }
+        return true
+    }
+
+    private fun checkListingUpdated(): Boolean {
+        val anySet = listingUpdatedUri != null || listingUpdatedWebhookSecret.isNotBlank()
+        if (!anySet) {
+            log.info("Adaptive Listings listing-updated webhook is not configured; none will be sent")
+            return false
+        }
+        if (listingUpdatedUri == null || listingUpdatedWebhookSecret.isBlank() || tenantId.isBlank()) {
+            log.error(
+                "Adaptive Listings listing-updated webhook is misconfigured and disabled " +
+                    "(url set: {}, secret set: {}, tenant-id set: {})",
+                listingUpdatedUri != null, listingUpdatedWebhookSecret.isNotBlank(), tenantId.isNotBlank()
+            )
+            return false
+        }
+        return true
+    }
+}
diff -ruN a/src/main/kotlin/com/time2show/core/service/adaptivelistings/BoundedHttpPost.kt b/src/main/kotlin/com/time2show/core/service/adaptivelistings/BoundedHttpPost.kt
