@@ -0,0 +1,68 @@
+package com.time2show.core.service.adaptivelistings
+
+import java.io.IOException
+import java.net.URI
+import java.net.http.HttpClient
+import java.net.http.HttpRequest
+import java.net.http.HttpResponse
+import java.nio.charset.StandardCharsets
+import java.time.Duration
+
+/**
+ * One best-effort POST to Adaptive Listings: bounded connect and request timeouts, a bounded number of
+ * sends, a re-send only after a 5xx or a network failure. Worst case is
+ * MAX_SENDS x (connect + request timeout) + the delays, on an `@Async` thread and never on a request.
+ */
+class BoundedHttpPost(
+    connectTimeout: Duration,
+    private val requestTimeout: Duration,
+    private val retryDelay: Duration,
+) {
+    // HTTP/1.1 is pinned: the JDK client otherwise tries an h2c upgrade on plain http, which `wrangler
+    // dev` and a proxy in front of the control plane have no reason to be asked about.
+    private val client: HttpClient = HttpClient.newBuilder()
+        .version(HttpClient.Version.HTTP_1_1)
+        .connectTimeout(connectTimeout)
+        .build()
+
+    /** How the last send ended. [status] is null when no response arrived. */
+    data class Outcome(val status: Int?, val body: String?, val sends: Int, val failure: String?)
+
+    /** [headers] is called once per send, so a signed caller signs each send freshly. */
+    fun post(uri: URI, body: String, headers: () -> Map<String, String>): Outcome {
+        var last = Outcome(null, null, 0, "not_sent")
+        for (send in 1..MAX_SENDS) {
+            last = sendOnce(uri, body, headers(), send)
+            val status = last.status
+            if ((status != null && status < 500) || send == MAX_SENDS) return last
+            try {
+                Thread.sleep(retryDelay.toMillis())
+            } catch (e: InterruptedException) {
+                Thread.currentThread().interrupt()
+                return last
+            }
+        }
+        return last
+    }
+
+    private fun sendOnce(uri: URI, body: String, headers: Map<String, String>, send: Int): Outcome {
+        val builder = HttpRequest.newBuilder(uri)
+            .timeout(requestTimeout)
+            .POST(HttpRequest.BodyPublishers.ofString(body, StandardCharsets.UTF_8))
+        headers.forEach { (name, value) -> builder.header(name, value) }
+        return try {
+            val response = client.send(builder.build(), HttpResponse.BodyHandlers.ofString(StandardCharsets.UTF_8))
+            Outcome(response.statusCode(), response.body(), send, null)
+        } catch (e: IOException) {
+            // The class name only: a message can carry the URL, and the log needs no more than the kind.
+            Outcome(null, null, send, e.javaClass.simpleName)
+        } catch (e: InterruptedException) {
+            Thread.currentThread().interrupt()
+            Outcome(null, null, send, "interrupted")
+        }
+    }
+
+    companion object {
+        const val MAX_SENDS = 3
+    }
+}
diff -ruN a/src/main/kotlin/com/time2show/core/service/adaptivelistings/BuyerSessionId.kt b/src/main/kotlin/com/time2show/core/service/adaptivelistings/BuyerSessionId.kt
--- a/src/main/kotlin/com/time2show/core/service/adaptivelistings/BuyerSessionId.kt	1970-01-01 01:00:00.000000000 +0100
+++ b/src/main/kotlin/com/time2show/core/service/adaptivelistings/BuyerSessionId.kt	2026-11-02 07:01:57.563055775 +0100
@@ -0,0 +1,37 @@
+package com.time2show.core.service.adaptivelistings
+
+import org.springframework.web.context.request.RequestContextHolder
+import org.springframework.web.context.request.ServletRequestAttributes
+
+/**
+ * The Adaptive Listings SDK's tab session id, as the front end hands it over on a conversion request
+ * and only there (`X-Estalara-Session-Id`, see docs/handover/estalara-app-patches/README.md in the
+ * Adaptive Listings repository). It is pseudonymous personal data that arrives in the same request as
+ * the buyer's login, so it is held in memory for the one event and is never stored or logged:
+ * [toString] is redacted because an async failure handler prints event objects, and every holder of
+ * this class is such an object.
+ */
+class BuyerSessionId private constructor(val value: String) {
+
+    override fun toString(): String = "BuyerSessionId(redacted)"
+
+    companion object {
+        const val HEADER = "X-Estalara-Session-Id"
+
+        /** Ingest's envelope bound (32-64 chars), narrowed to the alphabet the SDK ever minted. */
+        private val FORMAT = Regex("^[A-Za-z0-9-]{32,64}$")
+
+        /** A well-formed id, or null: a malformed header is the same as none and is never echoed. */
+        fun parse(raw: String?): BuyerSessionId? =
+            raw?.takeIf { FORMAT.matches(it) }?.let { BuyerSessionId(it) }
+
+        /**
+         * The id on the current servlet request. Must be called on the request thread, before the
+         * event crosses to `@Async`, where no request is bound. Null outside a request.
+         */
+        fun fromCurrentRequest(): BuyerSessionId? {
+            val attributes = RequestContextHolder.getRequestAttributes() as? ServletRequestAttributes
+            return parse(attributes?.request?.getHeader(HEADER))
+        }
+    }
+}
diff -ruN a/src/main/kotlin/com/time2show/core/service/adaptivelistings/ConversionEventClient.kt b/src/main/kotlin/com/time2show/core/service/adaptivelistings/ConversionEventClient.kt
--- a/src/main/kotlin/com/time2show/core/service/adaptivelistings/ConversionEventClient.kt	1970-01-01 01:00:00.000000000 +0100
+++ b/src/main/kotlin/com/time2show/core/service/adaptivelistings/ConversionEventClient.kt	2026-11-02 07:01:57.571055703 +0100
@@ -0,0 +1,107 @@
+package com.time2show.core.service.adaptivelistings
+
+import com.fasterxml.jackson.core.JsonProcessingException
+import com.fasterxml.jackson.databind.ObjectMapper
+import org.slf4j.LoggerFactory
+import org.springframework.stereotype.Component
+import java.util.UUID
+
+/**
+ * Sends the two server-confirmed conversions to Adaptive Listings ingest, signed with the server key.
+ * Ingest marks a signed row `caller_signed = 1`, the only class the lift counts.
+ *
+ * Carries `session_id` and nothing that identifies the buyer: no login, no account id, no name, no
+ * `lead_id`, and no `xid` (ESC-090 ruling 4). The tenant is a placeholder that ingest overwrites from
+ * the key's record, as the SDK's is.
+ */
+@Component
+class ConversionEventClient(private val properties: AdaptiveListingsProperties) {
+
+    private val log = LoggerFactory.getLogger(ConversionEventClient::class.java)
+    private val objectMapper = ObjectMapper()
+    private val http = BoundedHttpPost(properties.connectTimeout, properties.requestTimeout, properties.retryDelay)
+
+    fun sendLiveSignup(sessionId: BuyerSessionId, liveUuid: UUID, listingUuid: UUID) {
+        send(TYPE_LIVE_SIGNUP, sessionId, listingUuid.toString(), livePayload(liveUuid))
+    }
+
+    fun sendInquiryCompleted(sessionId: BuyerSessionId) {
+        send(TYPE_INQUIRY_COMPLETED, sessionId, null, INQUIRY_PAYLOAD)
+    }
+
+    private fun send(type: String, sessionId: BuyerSessionId, listingId: String?, payload: Map<String, String>) {
+        val uri = properties.eventsUri
+        if (!properties.eventsConfigured || uri == null) {
+            log.debug("al_conversion_skipped type={} reason=not_configured", type)
+            return
+        }
+        val eventId = UUID.randomUUID()
+        val body = buildBody(type, sessionId.value, listingId, payload, System.currentTimeMillis(), eventId)
+        // Same event on every send, fresh timestamp and nonce: a nonce is single-use at ingest.
+        val outcome = http.post(uri, body) { signedHeaders(body) }
+        val status = outcome.status
+        if (status != null && status in 200..299 && acceptedCount(outcome.body) == 1) {
+            log.info("al_conversion_sent type={} event_id={} sends={}", type, eventId, outcome.sends)
+        } else {
+            // A 200 with accepted 0 is a schema refusal: the conversion is lost and must not look sent.
+            log.warn(
+                "al_conversion_failed type={} event_id={} sends={} status={} failure={}",
+                type, eventId, outcome.sends, status, outcome.failure ?: "not_accepted"
+            )
+        }
+    }
+
+    private fun signedHeaders(body: String): Map<String, String> {
+        val timestamp = System.currentTimeMillis().toString()
+        val nonce = UUID.randomUUID().toString().replace("-", "")
+        return mapOf(
+            "Content-Type" to "application/json",
+            "X-Estalara-API-Key" to properties.serverApiKey,
+            "X-Estalara-Signature" to SignedEventSigner.sign(properties.hmacSecretHex, timestamp, nonce, body),
+            "X-Estalara-Timestamp" to timestamp,
+            "X-Estalara-Nonce" to nonce,
+        )
+    }
+
+    private fun acceptedCount(body: String?): Int? = try {
+        body?.let { objectMapper.readTree(it).path("accepted").takeIf { node -> node.isInt }?.intValue() }
+    } catch (e: JsonProcessingException) {
+        null
+    }
+
+    /** The exact request body, separate so a test can pin it against the ingest test's golden copy. */
+    fun buildBody(
+        type: String,
+        sessionId: String,
+        listingId: String?,
+        payload: Map<String, String>,
+        now: Long,
+        eventId: UUID,
+    ): String {
+        val event = linkedMapOf<String, Any>(
+            "event_id" to eventId.toString(),
+            "tenant_id" to PLACEHOLDER_TENANT,
+            "session_id" to sessionId,
+            "ts" to now,
+            "region" to "eu",
+            // The front end sends the header only while the SDK's consent is granted (see the README).
+            "consent_state" to "consented",
+            "schema_version" to 1,
+            "type" to type,
+        )
+        if (listingId != null) event["listing_id"] = listingId
+        event["payload"] = payload
+        return objectMapper.writeValueAsString(mapOf("events" to listOf(event)))
+    }
+
+    companion object {
+        const val TYPE_LIVE_SIGNUP = "live.signup"
+        const val TYPE_INQUIRY_COMPLETED = "inquiry.completed"
+        private const val PLACEHOLDER_TENANT = "00000000-0000-0000-0000-000000000000"
+
+        val INQUIRY_PAYLOAD: Map<String, String> = linkedMapOf("channel" to "conversation")
+
+        fun livePayload(liveUuid: UUID): Map<String, String> =
+            linkedMapOf("slot_uuid" to liveUuid.toString(), "event_kind" to "live_presentation")
+    }
+}
diff -ruN a/src/main/kotlin/com/time2show/core/service/adaptivelistings/ConversionEventListener.kt b/src/main/kotlin/com/time2show/core/service/adaptivelistings/ConversionEventListener.kt
--- a/src/main/kotlin/com/time2show/core/service/adaptivelistings/ConversionEventListener.kt	1970-01-01 01:00:00.000000000 +0100
+++ b/src/main/kotlin/com/time2show/core/service/adaptivelistings/ConversionEventListener.kt	2026-11-02 07:01:57.571055703 +0100
@@ -0,0 +1,54 @@
+package com.time2show.core.service.adaptivelistings
+
+import com.time2show.core.model.enums.ConversationParticipantRole
+import com.time2show.core.service.web.ConversationCreatedEvent
+import org.slf4j.LoggerFactory
+import org.springframework.scheduling.annotation.Async
+import org.springframework.stereotype.Component
+import org.springframework.transaction.event.TransactionPhase
+import org.springframework.transaction.event.TransactionalEventListener
+
+/**
+ * The two places a conversion is emitted (CEO ruling D-J): a buyer's registration for a live
+ * presentation and a conversation a buyer started.
+ *
+ * After commit, so a rolled-back registration emits nothing; `@Async`, so the request never waits; and
+ * nothing thrown here leaves this class, so a failure cannot reach registration or conversation
+ * creation. Without a session id there is nothing to attribute the conversion to: nothing is sent and
+ * one line without personal data says so. A conversion is never sent with a made-up session.
+ */
+@Component
+class ConversionEventListener(private val client: ConversionEventClient) {
+
+    private val log = LoggerFactory.getLogger(ConversionEventListener::class.java)
+
+    @Async
+    @TransactionalEventListener(phase = TransactionPhase.AFTER_COMMIT)
+    fun onLivePresentationRegistered(event: LivePresentationRegisteredEvent) {
+        emit(ConversionEventClient.TYPE_LIVE_SIGNUP, event.buyerSessionId) { sessionId ->
+            client.sendLiveSignup(sessionId, event.liveUuid, event.listingUuid)
+        }
+    }
+
+    @Async
+    @TransactionalEventListener(phase = TransactionPhase.AFTER_COMMIT)
+    fun onConversationCreated(event: ConversationCreatedEvent) {
+        if (event.initiatorRole != ConversationParticipantRole.BUYER) return
+        emit(ConversionEventClient.TYPE_INQUIRY_COMPLETED, event.buyerSessionId) { sessionId ->
+            client.sendInquiryCompleted(sessionId)
+        }
+    }
+
+    private fun emit(type: String, sessionId: BuyerSessionId?, send: (BuyerSessionId) -> Unit) {
+        if (sessionId == null) {
+            log.info("al_conversion_skipped type={} reason=no_session", type)
+            return
+        }
+        try {
+            send(sessionId)
+        } catch (e: Exception) {
+            // Without the message or the stack: neither is needed to see the kind, and both can quote data.
+            log.warn("al_conversion_failed type={} failure={}", type, e.javaClass.simpleName)
+        }
+    }
+}
