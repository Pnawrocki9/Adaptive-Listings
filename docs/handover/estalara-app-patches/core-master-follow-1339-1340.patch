+            """"payload":{"slot_uuid":"01928f00-7000-4000-8000-0000000000aa","event_kind":"live_presentation"}}]}"""
+
+    const val INQUIRY_BODY =
+        """{"events":[{$ENVELOPE,"type":"inquiry.completed","payload":{"channel":"conversation"}}]}"""
+
+    /** Pins the byte encoding: the verifier signs UTF-8 and this body is not ASCII. */
+    const val UTF8_BODY = """{"note":"zażółć gęślą jaźń"}"""
