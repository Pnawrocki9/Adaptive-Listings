+
+    private val listingAuthorization = mock<com.time2show.core.service.web.ListingAuthorizationService>()
+
+    private val service = CalendarServiceImpl(
+        mock(), calendarRepository, listingRepository, listingAuthorization, accountRepository, liveRepository,
+        registrationRepository, mock(), mock(), publisher
+    )
+
+    private val liveUuid = UUID.randomUUID()
+    private val listingUuid = UUID.randomUUID()
+    private val live = mock<LivePresentationEntity>()
+    private val account = mock<AccountEntity>()
+    private val jwt = JwtUserDetails(username = "buyer", authorities = listOf(SimpleGrantedAuthority("user")))
+
+    @BeforeEach
+    fun setUp() {
+        val listing = mock<ListingEntity> { on { uuid } doReturn listingUuid }
+        val calendarEvent = mock<CalendarEventEntity> {
+            on { startDate } doReturn Instant.now()
+            on { endDate } doReturn Instant.now().plusSeconds(3600)
+        }
+        whenever(live.uuid).thenReturn(liveUuid)
+        whenever(live.listing).thenReturn(listing)
+        whenever(live.status).thenReturn(LivePresentationStatus.SCHEDULED)
+        whenever(live.maxParticipants).thenReturn(10)
+        whenever(live.calendarEvent).thenReturn(calendarEvent)
+        whenever(liveRepository.findByUuid(liveUuid)).thenReturn(live)
+        whenever(accountRepository.findByLogin("buyer")).thenReturn(account)
+        whenever(registrationRepository.countAllByLivePresentationAndCalendarEvent_RemovedFalse(live)).thenReturn(1)
+        whenever(calendarRepository.save(any<CalendarEventEntity>())).thenAnswer { it.arguments[0] }
+
+        val request = MockHttpServletRequest()
+        request.addHeader(BuyerSessionId.HEADER, SignedEventVectors.SESSION_ID)
+        RequestContextHolder.setRequestAttributes(ServletRequestAttributes(request))
+    }
+
+    @AfterEach
+    fun tearDown() = RequestContextHolder.resetRequestAttributes()
+
+    private fun enroll() = service.createLiveEnrollmentEvent(
+        CreateLiveEnrollmentEventRequestTO(uuidLive = liveUuid.toString()), ApplicationLanguage.EN, jwt
+    )
+
+    @Test
+    fun `a new registration by a buyer publishes the registration with the request's session id`() {
+        whenever(registrationRepository.findByLivePresentationAndParticipant_Login(eq(live), eq("buyer"))).thenReturn(null)
+
+        assertEquals(HttpStatus.OK, enroll().httpStatus)
+
+        val captor = argumentCaptor<Any>()
+        verify(publisher).publishEvent(captor.capture())
+        val event = captor.firstValue as LivePresentationRegisteredEvent
+        assertEquals(liveUuid, event.liveUuid)
+        assertEquals(listingUuid, event.listingUuid)
+        assertEquals(SignedEventVectors.SESSION_ID, event.buyerSessionId?.value)
+    }
+
+    @Test
+    fun `an agent registering is no buyer conversion`() {
+        whenever(account.isActiveAgent()).thenReturn(true)
+        whenever(registrationRepository.findByLivePresentationAndParticipant_Login(eq(live), eq("buyer"))).thenReturn(null)
+
+        assertEquals(HttpStatus.OK, enroll().httpStatus)
+
+        verify(publisher, never()).publishEvent(any<Any>())
+    }
+
+    @Test
+    fun `a collaborator or agency admin without the agent role is no buyer either`() {
+        whenever(account.isActiveAgent()).thenReturn(false)
+        whenever(listingAuthorization.canManageListing("buyer", listingUuid)).thenReturn(true)
+        whenever(registrationRepository.findByLivePresentationAndParticipant_Login(eq(live), eq("buyer"))).thenReturn(null)
+
+        assertEquals(HttpStatus.OK, enroll().httpStatus)
+
+        verify(publisher, never()).publishEvent(any<Any>())
+    }
+
+    @Test
+    fun `pressing register again publishes nothing`() {
+        whenever(registrationRepository.findByLivePresentationAndParticipant_Login(eq(live), eq("buyer")))
+            .thenReturn(mock<LivePresentationRegistrationEntity>())
+
+        assertEquals(HttpStatus.OK, enroll().httpStatus)
+
+        verify(publisher, never()).publishEvent(any<Any>())
+    }
+}
