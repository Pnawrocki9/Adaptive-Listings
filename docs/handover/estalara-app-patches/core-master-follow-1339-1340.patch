+package com.time2show.core.service.adaptivelistings
+
+import org.slf4j.LoggerFactory
+import org.springframework.scheduling.concurrent.ThreadPoolTaskExecutor
+import java.util.concurrent.RejectedExecutionHandler
+
+/**
+ * The bounded pool behind the conversion listeners. A bare `@Async` here falls back to a new thread per
+ * call, because this application defines several executors and none named `taskExecutor`, and a slow
+ * ingest would then grow threads without limit. A full queue drops the conversion with one line and
+ * never throws: the caller is an after-commit callback of a buyer's request.
+ */
+object AdaptiveListingsExecutor {
+    const val BEAN_NAME = "adaptiveListingsExecutor"
+
+    private val log = LoggerFactory.getLogger(AdaptiveListingsExecutor::class.java)
+
+    private val dropAndLog = RejectedExecutionHandler { _, _ ->
+        log.warn("al_conversion_dropped reason=executor_full")
+    }
+
+    fun build(threads: Int = 2, queueCapacity: Int = 100): ThreadPoolTaskExecutor =
+        ThreadPoolTaskExecutor().apply {
+            corePoolSize = threads
+            maxPoolSize = threads
+            setQueueCapacity(queueCapacity)
+            setThreadNamePrefix("adaptive-listings-")
+            setRejectedExecutionHandler(dropAndLog)
+            initialize()
+        }
+}
