+import java.nio.charset.StandardCharsets
+import java.time.Duration
+import java.util.UUID
+import java.util.concurrent.CopyOnWriteArrayList
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+
+/** Real HTTP against a real local socket: what is asserted is what left the JDK client. */
+@DisplayName("ConversionEventClient (unit, real HTTP)")
+@Tag("unit")
+class ConversionEventClientTest {
+
+    private data class Received(val headers: Map<String, String?>, val body: String)
+
+    private val secret = "ab".repeat(32)
+    private val apiKey = "test-server-key"
+    private val sessionId = BuyerSessionId.parse(SignedEventVectors.SESSION_ID)!!
+
+    private lateinit var server: HttpServer
+    private val received = CopyOnWriteArrayList<Received>()
+    private val responses = ArrayDeque<Pair<Int, String>>()
+    private val appender = ListAppender<ILoggingEvent>()
+    private val release = CountDownLatch(1)
+
+    @BeforeEach
+    fun setUp() {
+        server = HttpServer.create(InetSocketAddress("127.0.0.1", 0), 0)
+        server.executor = Executors.newCachedThreadPool()
+        server.createContext("/v1/events") { exchange ->
+            val body = exchange.requestBody.readAllBytes().toString(StandardCharsets.UTF_8)
+            received += Received(
+                listOf(
+                    "X-Estalara-API-Key", "X-Estalara-Signature", "X-Estalara-Timestamp", "X-Estalara-Nonce",
+                    "Origin", "Content-Type", "Upgrade"
+                ).associateWith { exchange.requestHeaders.getFirst(it) },
+                body
+            )
+            val (status, answer) = synchronized(responses) { responses.removeFirstOrNull() } ?: (200 to """{"accepted":1,"rejected":0}""")
+            if (status == HANG) {
+                release.await(10, TimeUnit.SECONDS)
+            }
+            val bytes = answer.toByteArray()
+            exchange.sendResponseHeaders(if (status == HANG) 200 else status, bytes.size.toLong())
+            exchange.responseBody.use { it.write(bytes) }
+        }
+        server.start()
+        appender.start()
+        (LoggerFactory.getLogger(ConversionEventClient::class.java) as Logger).addAppender(appender)
+    }
+
+    @AfterEach
+    fun tearDown() {
+        release.countDown()
+        (LoggerFactory.getLogger(ConversionEventClient::class.java) as Logger).detachAppender(appender)
+        server.stop(0)
+    }
+
+    private fun client(requestTimeout: Duration = Duration.ofSeconds(2)) = ConversionEventClient(
+        AdaptiveListingsProperties(
+            "http://127.0.0.1:${server.address.port}", apiKey, secret, "", "", "",
+            Duration.ofSeconds(1), requestTimeout, Duration.ofMillis(5)
+        )
+    )
+
+    private fun respond(vararg answers: Pair<Int, String>) = synchronized(responses) { responses.addAll(answers) }
+
+    private fun logs() = appender.list.joinToString("\n") { it.formattedMessage }
+
+    @Test
+    fun `the live signup body is byte-identical to the golden copy ingest validates`() {
+        assertEquals(
+            SignedEventVectors.LIVE_BODY,
+            client().buildBody(
+                ConversionEventClient.TYPE_LIVE_SIGNUP, SignedEventVectors.SESSION_ID, SignedEventVectors.LISTING_ID,
+                ConversionEventClient.livePayload(SignedEventVectors.LIVE_UUID), SignedEventVectors.NOW, SignedEventVectors.EVENT_ID
+            )
+        )
+    }
+
+    @Test
+    fun `the inquiry body is byte-identical to the golden copy ingest validates`() {
+        assertEquals(
+            SignedEventVectors.INQUIRY_BODY,
+            client().buildBody(
+                ConversionEventClient.TYPE_INQUIRY_COMPLETED, SignedEventVectors.SESSION_ID, null,
+                ConversionEventClient.INQUIRY_PAYLOAD, SignedEventVectors.NOW, SignedEventVectors.EVENT_ID
+            )
+        )
+    }
+
+    @Test
+    fun `a sent event is signed as a server caller and carries the session id and nothing else about the buyer`() {
+        client().sendLiveSignup(sessionId, SignedEventVectors.LIVE_UUID, UUID.fromString(SignedEventVectors.LISTING_ID))
+
+        assertEquals(1, received.size)
+        val request = received.single()
+        assertEquals(apiKey, request.headers["X-Estalara-API-Key"])
+        assertEquals("application/json", request.headers["Content-Type"])
+        assertNull(request.headers["Origin"], "an Origin would route this to the unsigned browser path")
+        assertNull(request.headers["Upgrade"], "no h2c upgrade towards wrangler or a proxy")
+        assertEquals(
+            SignedEventSigner.sign(secret, request.headers["X-Estalara-Timestamp"]!!, request.headers["X-Estalara-Nonce"]!!, request.body),
+            request.headers["X-Estalara-Signature"]
+        )
+
+        val event = ObjectMapper().readTree(request.body)["events"][0]
+        assertEquals(SignedEventVectors.SESSION_ID, event["session_id"].asText())
+        assertEquals(
+            setOf(
+                "event_id", "tenant_id", "session_id", "ts", "region", "consent_state", "schema_version",
+                "type", "listing_id", "payload"
+            ),
+            event.fieldNames().asSequence().toSet(),
+            "ESC-090 ruling 4: no xid and no cross_session_id; no login, account id or lead_id either"
+        )
+        assertEquals(setOf("slot_uuid", "event_kind"), event["payload"].fieldNames().asSequence().toSet())
+    }
+
+    @Test
+    fun `a 5xx is re-sent as the same event with a fresh timestamp and nonce`() {
+        respond(503 to "", 503 to "")
+
+        client().sendInquiryCompleted(sessionId)
+
+        assertEquals(3, received.size)
+        assertEquals(1, received.map { it.body }.toSet().size, "a re-send is the same conversion")
+        assertEquals(3, received.map { it.headers["X-Estalara-Nonce"] }.toSet().size, "a nonce is single-use at ingest")
+        assertTrue(logs().contains("al_conversion_sent"))
+        assertTrue(logs().contains("sends=3"))
+    }
+
+    @Test
+    fun `a 401 is an answer and is not re-sent`() {
+        respond(401 to """{"error":{"code":"unauthorized"}}""")
+
+        client().sendInquiryCompleted(sessionId)
+
+        assertEquals(1, received.size)
+        assertTrue(logs().contains("al_conversion_failed"))
+        assertTrue(logs().contains("status=401"))
+    }
+
+    @Test
+    fun `a 200 that accepted nothing is a lost conversion, not a sent one`() {
+        respond(200 to """{"accepted":0,"rejected":1,"errors":[]}""")
+
+        client().sendInquiryCompleted(sessionId)
+
+        assertEquals(1, received.size)
+        assertFalse(logs().contains("al_conversion_sent"))
+        assertTrue(logs().contains("failure=not_accepted"))
+    }
+
+    @Test
+    fun `a hanging ingest gives up inside the bound and does not throw`() {
+        respond(HANG to "", HANG to "", HANG to "")
+        val timeout = Duration.ofMillis(150)
+
+        val startedAt = System.nanoTime()
+        client(requestTimeout = timeout).sendInquiryCompleted(sessionId)
+        val elapsed = Duration.ofNanos(System.nanoTime() - startedAt)
+
+        // The client's own count: a request it abandoned may never reach the test server's handler.
+        assertTrue(logs().contains("sends=${BoundedHttpPost.MAX_SENDS}"))
+        assertTrue(received.size <= BoundedHttpPost.MAX_SENDS)
+        assertTrue(elapsed < Duration.ofSeconds(10), "took $elapsed")
+        assertTrue(logs().contains("al_conversion_failed"))
+    }
+
+    @Test
+    fun `an unreachable ingest does not throw`() {
+        val port = server.address.port
+        server.stop(0)
+        val unreachable = ConversionEventClient(
+            AdaptiveListingsProperties(
+                "http://127.0.0.1:$port", apiKey, secret, "", "", "",
+                Duration.ofMillis(200), Duration.ofMillis(200), Duration.ofMillis(5)
+            )
+        )
+
+        unreachable.sendInquiryCompleted(sessionId)
+
+        assertTrue(logs().contains("al_conversion_failed"))
+    }
+
+    @Test
+    fun `no log line carries the secret, the api key, the session id or the signature`() {
+        respond(503 to "", 401 to "{}")
+
+        client().sendInquiryCompleted(sessionId)
+
+        val text = logs()
+        assertTrue(text.isNotEmpty())
+        assertFalse(text.contains(secret))
+        assertFalse(text.contains(apiKey))
+        assertFalse(text.contains(SignedEventVectors.SESSION_ID))
+        assertFalse(text.contains("hmac-sha256"))
+    }
+
+    @Test
+    fun `not configured sends nothing`() {
+        val unconfigured = ConversionEventClient(
+            AdaptiveListingsProperties("", "", "", "", "", "", Duration.ofSeconds(1), Duration.ofSeconds(1), Duration.ofMillis(1))
+        )
+
+        unconfigured.sendInquiryCompleted(sessionId)
+
+        assertEquals(0, received.size)
+    }
+
+    @Test
+    fun `a secret that is not hex disables the emitter instead of signing with garbage`() {
+        val bad = AdaptiveListingsProperties(
+            "http://127.0.0.1:${server.address.port}", apiKey, "not-hex-at-all", "", "", "",
+            Duration.ofSeconds(1), Duration.ofSeconds(1), Duration.ofMillis(1)
+        )
+
+        assertFalse(bad.eventsConfigured)
+        ConversionEventClient(bad).sendInquiryCompleted(sessionId)
+        assertEquals(0, received.size)
+        assertNotEquals(true, bad.toString().contains("not-hex-at-all"))
+    }
+
+    private companion object {
+        const val HANG = -1
+    }
+}
