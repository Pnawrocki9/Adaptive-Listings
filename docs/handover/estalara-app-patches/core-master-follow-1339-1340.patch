+
+@DisplayName("SignedEventSigner: same vector as the ingest verifier")
+@Tag("unit")
+class SignedEventSignerTest {
+
+    private fun sign(body: String) = SignedEventSigner.sign(
+        SignedEventVectors.SECRET_HEX, SignedEventVectors.TIMESTAMP, SignedEventVectors.NONCE, body
+    )
+
+    @Test
+    fun `live signup body signs to the shared vector`() {
+        assertEquals("hmac-sha256:${SignedEventVectors.LIVE_SIGNATURE}", sign(SignedEventVectors.LIVE_BODY))
+    }
+
+    @Test
+    fun `inquiry body signs to the shared vector`() {
+        assertEquals("hmac-sha256:${SignedEventVectors.INQUIRY_SIGNATURE}", sign(SignedEventVectors.INQUIRY_BODY))
+    }
+
+    @Test
+    fun `a non-ascii body is signed over its UTF-8 bytes`() {
+        assertEquals("hmac-sha256:${SignedEventVectors.UTF8_SIGNATURE}", sign(SignedEventVectors.UTF8_BODY))
+    }
+
+    @Test
