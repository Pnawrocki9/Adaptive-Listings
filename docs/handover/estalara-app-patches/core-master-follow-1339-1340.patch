+import java.nio.charset.StandardCharsets
+import java.time.Duration
+import java.util.UUID
+import java.util.concurrent.CopyOnWriteArrayList
+
+@DisplayName("ListingUpdatedNotifier (unit, real HTTP)")
+@Tag("unit")
+class ListingUpdatedNotifierTest {
+
+    private val tenant = "00000000-0000-0000-0000-0000000000e2"
+    private val listing = "839ecbd1-4e7d-4fd9-bda7-37ceb27eaa1c"
+    private val secret = "webhook-test-value"
+    private val jobs = mock<AsyncJobCreator>()
+
+    private lateinit var server: HttpServer
+    private val bodies = CopyOnWriteArrayList<String>()
+    private val secrets = CopyOnWriteArrayList<String?>()
+    private var status = 200
+
+    @BeforeEach
+    fun setUp() {
+        server = HttpServer.create(InetSocketAddress("127.0.0.1", 0), 0)
+        server.createContext("/api/webhooks/listing-updated") { exchange ->
+            bodies += exchange.requestBody.readAllBytes().toString(StandardCharsets.UTF_8)
+            secrets += exchange.requestHeaders.getFirst("X-Webhook-Secret")
+            exchange.sendResponseHeaders(status, -1)
+            exchange.close()
+        }
+        server.start()
+    }
+
+    @AfterEach
+    fun tearDown() = server.stop(0)
+
+    private fun properties(
+        url: String = "http://127.0.0.1:${server.address.port}/api/webhooks/listing-updated",
+        key: String = secret,
+        tenantId: String = tenant,
+    ) = AdaptiveListingsProperties(
+        "", "", "", tenantId, url, key,
+        Duration.ofSeconds(1), Duration.ofSeconds(1), Duration.ofMillis(5)
+    )
+
+    private fun notifier(properties: AdaptiveListingsProperties = properties()) = ListingUpdatedNotifier(properties, jobs)
+
+    private fun patch(
+        status: ListingStatus = ListingStatus.ACTIVE,
+        price: Double? = null,
+        city: String? = null,
+        district: String? = null,
+        images: List<String>? = null,
+    ) = PatchOwnListingRequestTO(
+        listingUuid = listing, status = status, price = price,
+        cityPlaceGoogleId = city, districtPlaceGoogleId = district, imageUuids = images
+    )
+
+    @Test
+    fun `a delivery posts the route's body with the route's secret header`() {
+        notifier().deliver(listing)
+
+        assertEquals(1, bodies.size)
+        val body = ObjectMapper().readTree(bodies.single())
+        assertEquals(tenant, body["tenant_id"].asText())
+        assertEquals(listing, body["listing_id"].asText())
+        assertEquals(setOf("tenant_id", "listing_id"), body.fieldNames().asSequence().toSet())
+        assertEquals(secret, secrets.single())
+    }
+
+    @Test
+    fun `a 500 fails the job after the bound, and the job's error carries neither secret nor URL`() {
+        status = 500
+
+        val error = assertThrows(IllegalStateException::class.java) { notifier().deliver(listing) }
+
+        assertEquals(BoundedHttpPost.MAX_SENDS, bodies.size)
+        assertTrue(error.message!!.contains("status=500"))
+        assertFalse(error.message!!.contains(secret))
+        assertFalse(error.message!!.contains("127.0.0.1"))
+    }
+
+    @Test
+    fun `a 401 fails the job without a re-send, so a corrected secret recovers it`() {
+        status = 401
+        assertThrows(IllegalStateException::class.java) { notifier().deliver(listing) }
+        assertEquals(1, bodies.size)
+    }
+
+    @Test
+    fun `an unreachable control plane fails the job`() {
+        val url = "http://127.0.0.1:${server.address.port}/api/webhooks/listing-updated"
+        server.stop(0)
+        assertThrows(IllegalStateException::class.java) { notifier(properties(url = url)).deliver(listing) }
+    }
+
+    @Test
+    fun `a save writes a durable job for the listing`() {
+        val uuid = UUID.fromString(listing)
+
+        notifier().enqueueInCurrentTx(uuid)
+
+        verify(jobs).enqueueJobInCurrentTx(
+            eq(AsyncJobType.LISTING_UPDATED_WEBHOOK), eq(AsyncAggregateType.LISTING), eq(listing), any(), eq(null), eq(null)
+        )
+    }
+
+    @Test
+    fun `not configured writes no job and sends nothing`() {
+        val unconfigured = notifier(properties(url = "", key = ""))
+
+        unconfigured.enqueueInCurrentTx(UUID.fromString(listing))
+        unconfigured.deliver(listing)
+
+        verify(jobs, never()).enqueueJobInCurrentTx(any(), any(), any(), any(), any(), any())
+        assertEquals(0, bodies.size)
+    }
+
+    @Test
+    fun `a tenant id that is not a canonical UUID disables the group`() {
+        assertTrue(properties().listingUpdatedConfigured)
+        assertFalse(properties(tenantId = "not-a-uuid").listingUpdatedConfigured)
+        assertFalse(properties(tenantId = "1-1-1-1-1").listingUpdatedConfigured)
+        assertFalse(properties(tenantId = "").listingUpdatedConfigured)
+    }
+
+    @Test
+    fun `a PATCH bumps the revision when it changes a grounded fact`() {
+        val draft = ListingStatus.DRAFT
+        assertTrue(ListingUpdatedNotifier.changesGroundingFacts(patch(price = 1.0), ListingStatus.ACTIVE))
+        assertTrue(ListingUpdatedNotifier.changesGroundingFacts(patch(city = "x"), ListingStatus.ACTIVE))
+        assertTrue(ListingUpdatedNotifier.changesGroundingFacts(patch(district = "x"), ListingStatus.ACTIVE))
+        assertTrue(ListingUpdatedNotifier.changesGroundingFacts(patch(status = draft, price = 1.0), draft))
+    }
+
+    @Test
+    fun `a publish bumps the revision, because a re-scrape leaves a DRAFT with no signal of its own`() {
+        assertTrue(ListingUpdatedNotifier.changesGroundingFacts(patch(status = ListingStatus.ACTIVE), ListingStatus.DRAFT))
+        assertTrue(ListingUpdatedNotifier.changesGroundingFacts(patch(status = ListingStatus.ACTIVE), ListingStatus.WITHDRAWN))
+    }
+
+    @Test
+    fun `a photo reorder does not, though status is mandatory on every PATCH`() {
+        assertFalse(ListingUpdatedNotifier.changesGroundingFacts(patch(images = listOf("x")), ListingStatus.ACTIVE))
+        assertFalse(ListingUpdatedNotifier.changesGroundingFacts(patch(status = ListingStatus.DRAFT), ListingStatus.ACTIVE))
+    }
+}
