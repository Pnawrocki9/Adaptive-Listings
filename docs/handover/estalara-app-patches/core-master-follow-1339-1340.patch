+package com.time2show.core.unit.service.adaptivelistings
+
+import java.util.UUID
+
+/**
+ * The vector shared with the verifier's test in the Adaptive Listings repository,
+ * `apps/ingest/src/signed-conversions.test.ts`, which holds byte-identical copies and runs them through
+ * the real `authenticateRequest()` and `EventSchema`. Change one, change both: a difference is a
+ * contract break neither side can see alone.
+ */
+object SignedEventVectors {
+    val SECRET_HEX = "cd".repeat(32)
+    const val TIMESTAMP = "1793577600000"
+    const val NONCE = "follow1339vector0001"
+    const val NOW = 1793577600000L
+
+    const val SESSION_ID = "11111111-2222-4333-8444-555555555555"
+    val EVENT_ID: UUID = UUID.fromString("01928f00-7000-4000-8000-000000001339")
+    val LIVE_UUID: UUID = UUID.fromString("01928f00-7000-4000-8000-0000000000aa")
+    const val LISTING_ID = "839ecbd1-4e7d-4fd9-bda7-37ceb27eaa1c"
+
+    private const val ENVELOPE =
+        """"event_id":"01928f00-7000-4000-8000-000000001339",""" +
+            """"tenant_id":"00000000-0000-0000-0000-000000000000",""" +
+            """"session_id":"11111111-2222-4333-8444-555555555555",""" +
+            """"ts":1793577600000,"region":"eu","consent_state":"consented","schema_version":1"""
+
+    const val LIVE_BODY =
+        """{"events":[{$ENVELOPE,"type":"live.signup","listing_id":"839ecbd1-4e7d-4fd9-bda7-37ceb27eaa1c",""" +
+            """"payload":{"slot_uuid":"01928f00-7000-4000-8000-0000000000aa","event_kind":"live_presentation"}}]}"""
+
+    const val INQUIRY_BODY =
+        """{"events":[{$ENVELOPE,"type":"inquiry.completed","payload":{"channel":"conversation"}}]}"""
+
+    /** Pins the byte encoding: the verifier signs UTF-8 and this body is not ASCII. */
+    const val UTF8_BODY = """{"note":"zażółć gęślą jaźń"}"""
+
+    // Split so no 64-char hex literal sits in a file a secret scanner reads.
+    val LIVE_SIGNATURE = listOf("8724a3c7fabd5513", "c7f42f7109f709c5", "af5c23005d6b6b0f", "71ad489f87aad922").joinToString("")
+    val INQUIRY_SIGNATURE = listOf("86a166343114ddbc", "0b918d46286b2e82", "1203a3405fb85f02", "13e4e0c05b7ba1a6").joinToString("")
+    val UTF8_SIGNATURE = listOf("068c7912934c8e72", "2ddd6993553b05da", "d4fa7c187a26d213", "e347e65d6cd89fdd").joinToString("")
+}
