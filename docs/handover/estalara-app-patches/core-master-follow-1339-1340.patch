+/** The enrollment button's path, which is where a buyer's registration normally happens. */
+@DisplayName("CalendarServiceImpl.createLiveEnrollmentEvent publishes the registration (unit)")
+@Tag("unit")
+class ConversionEventSitesTest {
+
+    private val publisher = mock<ApplicationEventPublisher>()
+    private val accountRepository = mock<AccountRepository>()
+    private val liveRepository = mock<LivePresentationRepository>()
+    private val registrationRepository = mock<LivePresentationRegistrationRepository>()
