+package com.time2show.core.service.adaptivelistings
+
+import com.fasterxml.jackson.databind.ObjectMapper
+import com.time2show.core.dto.PatchOwnListingRequestTO
+import com.time2show.core.dto.async.ListingUpdatedWebhookJobPayload
+import com.time2show.core.model.enums.AsyncAggregateType
+import com.time2show.core.model.enums.AsyncJobType
+import com.time2show.core.model.enums.ListingStatus
+import com.time2show.core.service.web.AsyncJobCreator
+import com.time2show.core.util.JsonUtils
+import org.slf4j.LoggerFactory
+import org.springframework.stereotype.Component
+import java.util.UUID
+
+/**
+ * Tells the Adaptive Listings control plane a listing's facts changed, so it advances the listing's
+ * revision and stops serving copy generated from the old ones (`POST /api/webhooks/listing-updated`).
+ *
+ * This webhook is the control plane's only change signal for a permanent cache, so a lost call means old
+ * copy until the next save. The call is therefore a durable async job, written in the save's own
+ * transaction: the save and the promise to announce it commit together, and the job retries for hours
+ * across a restart of either side. It finally alerts the admins (DEAD_LETTER) and can be retried by hand.
+ */
+@Component
+class ListingUpdatedNotifier(
+    private val properties: AdaptiveListingsProperties,
+    private val asyncJobCreator: AsyncJobCreator,
+) {
+    private val log = LoggerFactory.getLogger(ListingUpdatedNotifier::class.java)
+    private val objectMapper = ObjectMapper()
+    private val http = BoundedHttpPost(properties.connectTimeout, properties.requestTimeout, properties.retryDelay)
+
+    /** Must run inside the transaction that saves the listing. No deduplication: every save must bump. */
+    fun enqueueInCurrentTx(listingUuid: UUID) {
+        if (!properties.listingUpdatedConfigured) {
+            log.debug("al_listing_updated_skipped reason=not_configured")
+            return
+        }
+        asyncJobCreator.enqueueJobInCurrentTx(
+            type = AsyncJobType.LISTING_UPDATED_WEBHOOK,
+            aggregateType = AsyncAggregateType.LISTING,
+            aggregateId = listingUuid.toString(),
+            payloadJson = JsonUtils.mapper.writeValueAsString(ListingUpdatedWebhookJobPayload(listingUuid.toString())),
+        )
+    }
+
+    /** One delivery attempt for the job. Throws unless the control plane answered 2xx, so the job retries. */
+    fun deliver(listingUuid: String) {
+        val uri = properties.listingUpdatedUri
+        if (!properties.listingUpdatedConfigured || uri == null) {
+            log.warn("al_listing_updated_skipped listing={} reason=not_configured_at_delivery", listingUuid)
+            return
+        }
+        val body = objectMapper.writeValueAsString(
+            mapOf("tenant_id" to properties.tenantId, "listing_id" to listingUuid)
+        )
+        val outcome = http.post(uri, body) {
+            mapOf("Content-Type" to "application/json", "X-Webhook-Secret" to properties.listingUpdatedWebhookSecret)
+        }
+        val status = outcome.status
+        if (status == null || status !in 200..299) {
+            // Stored as the job's last_error: no secret, no URL.
+            throw IllegalStateException(
+                "listing-updated webhook not delivered: sends=${outcome.sends} status=$status failure=${outcome.failure ?: "refused"}"
+            )
+        }
+        log.info("al_listing_updated_sent listing={} sends={}", listingUuid, outcome.sends)
+    }
+
+    companion object {
+        /**
+         * Whether a PATCH changed a fact adapted copy is grounded on: the price, the place, or a publish.
+         * A publish counts because a re-scrape rewrites a listing's text and leaves it DRAFT, with no signal
+         * of its own. `status` is mandatory on every PATCH, so only the transition counts: a photo reorder
+         * on a live listing also says ACTIVE, and a regeneration for that would be paid for nothing.
+         */
+        fun changesGroundingFacts(request: PatchOwnListingRequestTO, previousStatus: ListingStatus): Boolean =
+            request.price != null || request.cityPlaceGoogleId != null || request.districtPlaceGoogleId != null ||
+                (request.status == ListingStatus.ACTIVE && previousStatus != ListingStatus.ACTIVE)
+    }
+}
