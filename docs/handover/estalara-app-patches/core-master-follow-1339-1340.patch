+import java.util.UUID
+
+@DisplayName("ConversionEventListener and BuyerSessionId (unit)")
+@Tag("unit")
+class ConversionEventListenerTest {
+
+    private val client = mock<ConversionEventClient>()
+    private val listener = ConversionEventListener(client)
+    private val session = BuyerSessionId.parse(SignedEventVectors.SESSION_ID)!!
+
+    private fun conversation(
+        role: ConversationParticipantRole,
+        sessionId: BuyerSessionId?,
+        recipientRole: ConversationParticipantRole? = ConversationParticipantRole.AGENT,
+    ) = ConversationCreatedEvent(
+        conversationUuid = UUID.randomUUID(),
+        initiatorSlug = "slug",
+        initiatorName = "name",
+        initiatorProfileImageUrl = null,
+        initiatorRole = role,
+        initiatorAgencyName = null,
+        recipientLogins = listOf("agent"),
+        buyerSessionId = sessionId,
+        recipientRole = recipientRole
+    )
+
+    @Test
+    fun `a conversation a buyer started with an agent is an inquiry`() {
+        listener.onConversationCreated(conversation(ConversationParticipantRole.BUYER, session))
+        verify(client).sendInquiryCompleted(session)
+    }
+
+    @Test
+    fun `a buyer writing to a non-agent has contacted no selling agent`() {
+        listener.onConversationCreated(
+            conversation(ConversationParticipantRole.BUYER, session, ConversationParticipantRole.BUYER)
+        )
+        verify(client, never()).sendInquiryCompleted(any())
+    }
+
+    @Test
+    fun `an unknown recipient role does not count`() {
+        listener.onConversationCreated(conversation(ConversationParticipantRole.BUYER, session, null))
+        verify(client, never()).sendInquiryCompleted(any())
+    }
+
+    @Test
+    fun `both listeners run on the bounded pool, not the thread-per-call fallback`() {
+        listOf("onConversationCreated", "onLivePresentationRegistered").forEach { name ->
+            val method = ConversionEventListener::class.java.methods.single { it.name == name }
+            assertEquals(
+                AdaptiveListingsExecutor.BEAN_NAME,
+                method.getAnnotation(org.springframework.scheduling.annotation.Async::class.java).value
+            )
+        }
+    }
+
+    @Test
+    fun `a full queue drops with one log line and never throws`() {
+        val executor = AdaptiveListingsExecutor.build(threads = 1, queueCapacity = 1)
+        val appender = ch.qos.logback.core.read.ListAppender<ch.qos.logback.classic.spi.ILoggingEvent>().apply { start() }
+        val logger = org.slf4j.LoggerFactory.getLogger(AdaptiveListingsExecutor::class.java) as ch.qos.logback.classic.Logger
+        // An integration test in the same JVM may have left the test profile's root=ERROR in force.
+        logger.level = ch.qos.logback.classic.Level.WARN
+        logger.addAppender(appender)
+        val release = java.util.concurrent.CountDownLatch(1)
+        try {
+            repeat(4) { executor.execute { release.await() } }
+
+            assertEquals(2, appender.list.count { it.formattedMessage == "al_conversion_dropped reason=executor_full" })
+        } finally {
+            release.countDown()
+            logger.detachAppender(appender)
+            executor.shutdown()
+        }
+    }
+
+    @Test
+    fun `a conversation an agent started is not`() {
+        listener.onConversationCreated(conversation(ConversationParticipantRole.AGENT, session))
+        verify(client, never()).sendInquiryCompleted(any())
+    }
+
+    @Test
+    fun `no session id, nothing is sent for either conversion`() {
+        listener.onConversationCreated(conversation(ConversationParticipantRole.BUYER, null))
+        listener.onLivePresentationRegistered(LivePresentationRegisteredEvent(UUID.randomUUID(), UUID.randomUUID(), null))
+        verify(client, never()).sendInquiryCompleted(any())
+        verify(client, never()).sendLiveSignup(any(), any(), any())
+    }
+
+    @Test
+    fun `a registration is a live signup with its live and listing`() {
+        val live = UUID.randomUUID()
+        val listing = UUID.randomUUID()
+        listener.onLivePresentationRegistered(LivePresentationRegisteredEvent(live, listing, session))
+        verify(client).sendLiveSignup(session, live, listing)
+    }
+
+    @Test
+    fun `a failing client never reaches the caller`() {
+        whenever(client.sendInquiryCompleted(any())) doThrow IllegalStateException("boom")
+        whenever(client.sendLiveSignup(any(), any(), any())) doThrow IllegalStateException("boom")
+
+        listener.onConversationCreated(conversation(ConversationParticipantRole.BUYER, session))
+        listener.onLivePresentationRegistered(LivePresentationRegisteredEvent(UUID.randomUUID(), UUID.randomUUID(), session))
+    }
+
+    @Test
+    fun `the session id accepts both shapes the SDK ever minted and refuses anything else`() {
+        assertEquals(SignedEventVectors.SESSION_ID, BuyerSessionId.parse(SignedEventVectors.SESSION_ID)?.value)
+        assertEquals("f".repeat(64), BuyerSessionId.parse("f".repeat(64))?.value)
+        assertNull(BuyerSessionId.parse(null))
+        assertNull(BuyerSessionId.parse(""))
+        assertNull(BuyerSessionId.parse("f".repeat(31)))
+        assertNull(BuyerSessionId.parse("f".repeat(65)))
+        assertNull(BuyerSessionId.parse("a".repeat(32) + "\nx"))
+        assertNull(BuyerSessionId.parse("<script>" + "a".repeat(32)))
+    }
+
+    @Test
+    fun `an event printed by the async failure handler does not print the session id`() {
+        assertFalse(session.toString().contains(SignedEventVectors.SESSION_ID))
+        assertFalse(conversation(ConversationParticipantRole.BUYER, session).toString().contains(SignedEventVectors.SESSION_ID))
+        assertFalse(
+            LivePresentationRegisteredEvent(UUID.randomUUID(), UUID.randomUUID(), session).toString()
+                .contains(SignedEventVectors.SESSION_ID)
+        )
+    }
+
+    @Test
+    fun `the id is read off the current request, and is null with no request or no header`() {
+        assertNull(BuyerSessionId.fromCurrentRequest())
+        val request = MockHttpServletRequest()
+        RequestContextHolder.setRequestAttributes(ServletRequestAttributes(request))
+        try {
+            assertNull(BuyerSessionId.fromCurrentRequest())
+            request.addHeader(BuyerSessionId.HEADER, SignedEventVectors.SESSION_ID)
+            assertEquals(SignedEventVectors.SESSION_ID, BuyerSessionId.fromCurrentRequest()?.value)
+        } finally {
+            RequestContextHolder.resetRequestAttributes()
+        }
+    }
+}
