@@ -0,0 +1,16 @@
+/**
+ * Estalara conversion header. Sent only on the requests that convert (a conversation with an
+ * agent, a LIVE registration, joining a LIVE); never from a shared interceptor.
+ * Returns the SDK's session id only while the buyer's consent is granted: the SDK mints a
+ * session id even after a denial, so the presence of an id is not proof of consent.
+ */
+export function estalaraConversionHeaders(): Record<string, string> {
+	try {
+		if (localStorage.getItem('estalara_consent') !== 'granted') return {};
+		const raw = sessionStorage.getItem('__estalara_session__');
+		const id = raw ? (JSON.parse(raw) as { sessionId?: unknown }).sessionId : undefined;
+		return typeof id === 'string' ? { 'X-Estalara-Session-Id': id } : {};
+	} catch {
+		return {};
+	}
+}
