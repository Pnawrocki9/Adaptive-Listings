{
  "name": "@estalara/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Estalara Drizzle ORM schemas and migrations for Supabase Postgres",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@estalara/shared": "workspace:*",
    "@types/node": "*",
    "drizzle-orm": "^0.44.0",
    "postgres": "^3.4.7",
    "typescript": "*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.1",
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "^2.1.9",
    "drizzle-kit": "^0.31.0",
    "vitest": "*",
    "zod": "^3.23.8"
  }
}
