{
  "name": "@estalara/sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "Estalara adaptive listings core embeddable SDK",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./playbooks": {
      "import": "./dist/core/playbooks/index.js",
      "types": "./dist/core/playbooks/index.d.ts"
    },
    "./auto-detect": {
      "import": "./dist/auto-detect/pipeline.js",
      "types": "./dist/auto-detect/pipeline.d.ts"
    },
    "./auto-detect/ai-vision": {
      "import": "./dist/auto-detect/techniques/ai-vision.js",
      "types": "./dist/auto-detect/techniques/ai-vision.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "tsup",
    "build:check": "node scripts/check-bundle-size.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:corpus": "vitest run --reporter=verbose --config vitest.corpus.config.ts",
    "test:e2e": "pnpm build && playwright test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "tsup": "^8.5.1",
    "typescript": "*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@estalara/shared": "workspace:^",
    "@playwright/test": "^1.59.1",
    "vitest": "*"
  }
}
