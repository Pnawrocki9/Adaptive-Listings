{
  "name": "@estalara/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Estalara shared Zod schemas and TypeScript types used across all services",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./observability": {
      "import": "./dist/observability/index.js",
      "require": "./dist/observability/index.cjs",
      "types": "./dist/observability/index.d.ts"
    },
    "./playbooks": {
      "import": "./dist/playbooks/index.js",
      "require": "./dist/playbooks/index.cjs",
      "types": "./dist/playbooks/index.d.ts"
    },
    "./playbook-traits": {
      "import": "./dist/playbooks/traits.js",
      "require": "./dist/playbooks/traits.cjs",
      "types": "./dist/playbooks/traits.d.ts"
    },
    "./browser-origins": {
      "import": "./dist/browser-origins.js",
      "require": "./dist/browser-origins.cjs",
      "types": "./dist/browser-origins.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/pino": "^7.0.5",
    "pino-pretty": "^13.1.3",
    "vitest": "*"
  },
  "dependencies": {
    "@types/node": "*",
    "typescript": "*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.7.0",
    "@opentelemetry/sdk-trace-node": "^2.7.0",
    "@opentelemetry/sdk-trace-web": "^2.7.0",
    "pino": "^10.3.1",
    "zod": "^3.23.8"
  }
}
